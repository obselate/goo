<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Version>$(GooReleaseVersion)</Version>
    <PackageId>Goo.Android</PackageId>
    <Description>Android presentation and input adapter for Goo's shared Vulkan UI runtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../docs/android.md" Pack="true" PackagePath="README.md" />
    <None Include="Goo.Android.targets" Pack="true" PackagePath="buildTransitive/Goo.Android.targets" />
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <AndroidNativeLibrary Include="../Goo/Runtime/Vulkan/android-arm64/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="../Goo/Runtime/Vulkan/android-x64/*.so" Abi="x86_64" />
  </ItemGroup>
  <Target Name="PrepareAndroidArchiveResources" BeforeTargets="_CreateAarCache" DependsOnTargets="_ComputeAndroidResourcePaths;_GenerateAndroidResourceDir" />
  <Target Name="RegisterAndroidDocumentation" AfterTargets="CoreCompile">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <None Include="$(DocumentationFile)" Pack="true" PackagePath="lib/$(TargetFramework)$(TargetPlatformVersion)/Goo.Android.xml" />
    </ItemGroup>
  </Target>
</Project>
