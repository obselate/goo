<Project>
  <Target Name="RegisterGooAndroidNativeAotResourceDesigner"
          AfterTargets="_AndroidComputeIlcCompileInputs"
          Condition="'$(PublishAot)' == 'true' and '$(AndroidUseDesignerAssembly)' == 'true'">
    <ItemGroup>
      <IlcReference Include="$(IntermediateLinkDir)$(_DesignerAssemblyName).dll" />
    </ItemGroup>
  </Target>
</Project>
