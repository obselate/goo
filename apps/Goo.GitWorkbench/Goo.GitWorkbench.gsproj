<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooGitWorkbench</RootNamespace>
    <AssemblyName>Goo.GitWorkbench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="0.6.5" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Watch Include="**/*.gs" Exclude="bin/**;obj/**" />
  </ItemGroup>
</Project>
