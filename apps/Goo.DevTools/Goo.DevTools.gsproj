<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <RootNamespace>GooDevTools</RootNamespace>
    <AssemblyName>Goo.DevTools</AssemblyName>
    <Version>$(GooReleaseVersion)</Version>
    <IsPackable>false</IsPackable>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tools/Goo.DevTools.Cli/CommandLine.gs" Link="Cli/CommandLine.gs" />
    <Compile Include="../../tools/Goo.DevTools.Cli/Discovery.gs" Link="Cli/Discovery.gs" />
    <Content Include="../../Goo/Runtime/Vulkan/linux-x64/*.so;../../Goo/Runtime/Vulkan/win-x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="$(GooLinuxSdlPath)" Link="libSDL3.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" Condition="'$(GooLinuxSdlPath)' != ''" />
    <Content Include="$(GooWindowsSdlPath)" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" Condition="'$(GooWindowsSdlPath)' != ''" />
    <Content Include="$(GooMacOsArm64NativeRoot)/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" Condition="'$(GooMacOsArm64NativeRoot)' != ''" />
    <Content Include="Assets/Fonts/*" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../../tests/Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf" Link="Fonts/VendSans-VariableFont_wght.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../../tests/Goo.VulkanProof/Assets/Text/VendSans-OFL.txt" Link="Fonts/VendSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <ProjectReference Include="../../Goo/Goo.gsproj" />
    <PackageReference Include="Goo.Widgets" Version="0.19.1" />
  </ItemGroup>
  <Import Project="../../Goo/Goo.targets" />
</Project>
