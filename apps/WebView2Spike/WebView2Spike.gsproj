<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebView2Spike</RootNamespace>
    <AssemblyName>WebView2Spike</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
  <Import Project="../../Goo/Goo.targets" />
</Project>
