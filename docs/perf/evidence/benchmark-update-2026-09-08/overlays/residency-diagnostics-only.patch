+internal unsafe partial class VulkanMemoryAllocator {
+  internal func SnapshotBlocks() []VulkanMemoryBlockSnapshot {
+    EnsureOpen()
+    let result = [blockCount]VulkanMemoryBlockSnapshot
+    var blockIndex int32 = 0
+    while blockIndex < blockCount {
+      guard let block = blocks[blockIndex] else {
+        throw InvalidOperationException("Vulkan memory block metadata is missing")
+      }
+      var allocatedPayload VkDeviceSize
+      var livePayload VkDeviceSize
+      var retiredPayload VkDeviceSize
+      var allocatedSpan VkDeviceSize
+      var liveAllocations uint32
+      var retiredAllocations uint32
+      var allocationIndex int32 = 0
+      while allocationIndex < activeCount {
+        if let allocation = activeAllocations[allocationIndex] {
+          if allocation.block == block {
+            allocatedPayload += allocation.size
+            allocatedSpan += allocation.placementSpan
+            if allocation.state == VulkanMemoryAllocationState.Live {
+              livePayload += allocation.size
+              liveAllocations++
+            } else if allocation.state == VulkanMemoryAllocationState.Retired {
+              retiredPayload += allocation.size
+              retiredAllocations++
+            }
+          }
+        }
+        allocationIndex++
+      }
+      if allocatedSpan > block.size {
+        throw InvalidOperationException("Vulkan memory block placement exceeds resident bytes")
+      }
+      let heap = MemoryHeap(memoryProperties, block.heapIndex)
+      result[blockIndex] = VulkanMemoryBlockSnapshot{
+        Memory: block.memory,
+        MemoryTypeIndex: block.memoryTypeIndex,
+        HeapIndex: block.heapIndex,
+        PropertyFlags: uint32(block.propertyFlags),
+        HeapSize: heap.size,
+        HeapFlags: uint32(heap.flags),
+        ResourceClass: block.resourceClass,
+        ResidentBlockBytes: block.size,
+        AllocatedPayloadBytes: allocatedPayload,
+        LivePayloadBytes: livePayload,
+        RetiredBytes: retiredPayload,
+        AllocatedSpanBytes: allocatedSpan,
+        FreeSpanBytes: block.size - allocatedSpan,
+        AllocationCount: block.allocationCount,
+        LiveAllocationCount: liveAllocations,
+        RetiredAllocationCount: retiredAllocations,
+        Dedicated: block.dedicated,
+        HostVisible: block.hostVisible,
+        HostCoherent: block.hostCoherent,
+        MappedAddress: if block.mapped == nil { 0uL } else { uint64(nint(block.mapped)) },
+        MappedBytes: if block.mapped == nil { 0uL } else { block.size },
+      }
+      blockIndex++
+    }
+    return result
+  }
+}
