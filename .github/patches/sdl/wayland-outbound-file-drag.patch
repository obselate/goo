+static const void *Goo_FileDragData(void *userdata, const char *mime_type, size_t *length)
+{
+    if (SDL_strcmp(mime_type, FILE_MIME) != 0) {
+        *length = 0;
+        return NULL;
+    }
+    *length = SDL_strlen((const char *)userdata);
+    return userdata;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_StartFileDrag(SDL_Window *window,
+    const char *uri_list, void (SDLCALL *completed)(void *, bool), void *userdata)
+{
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+    if (!_this || !window || !window->internal || !uri_list || !*uri_list || !completed ||
+        SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0) {
+        return SDL_SetError("Native file drag requires an open Wayland window and nonempty URI list");
+    }
+    if (SDL_strlen(uri_list) > 1048576) {
+        return SDL_SetError("Native URI list exceeds 1 MiB");
+    }
+    SDL_VideoData *display = _this->internal;
+    SDL_WindowData *wind = window->internal;
+    if (!display->data_device_manager ||
+        wl_data_device_manager_get_version(display->data_device_manager) < 3 ||
+        SDL_GetPointerProperty(SDL_GetWindowProperties(window), "Goo.FileDrag.1", NULL)) {
+        return SDL_SetError("Native file drag is unavailable or already active");
+    }
+    SDL_WaylandSeat *seat;
+    wl_list_for_each (seat, &display->seat_list, link) {
+        if (seat->pointer.focus == wind &&
+            (seat->pointer.buttons_pressed & SDL_BUTTON_MASK(SDL_BUTTON_LEFT)) &&
+            seat->goo_file_drag_serial && seat->data_device && seat->data_device->data_device) {
+            break;
+        }
+    }
+    if (&seat->link == &display->seat_list) {
+        return SDL_SetError("Native file drag requires a held primary press on this window");
+    }
+    SDL_WaylandDataSource *source = Wayland_data_source_create(_this);
+    if (!source) {
+        return false;
+    }
+    char *owned = SDL_strdup(uri_list);
+    if (!owned) {
+        Wayland_data_source_destroy(source);
+        return false;
+    }
+    Wayland_data_source_set_callback(source, Goo_FileDragData, owned, 0);
+    source->data_device = seat->data_device;
+    source->goo_drag_window = window;
+    source->goo_drag_finished = completed;
+    source->goo_drag_userdata = userdata;
+    if (!SDL_SetPointerProperty(SDL_GetWindowProperties(window), "Goo.FileDrag.1", source)) {
+        Wayland_data_source_destroy(source);
+        return false;
+    }
+    seat->data_device->goo_drag_source = source;
+    wl_data_source_offer(source->source, FILE_MIME);
+    wl_data_source_set_actions(source->source, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+    wl_data_device_start_drag(seat->data_device->data_device, source->source,
+                              wind->surface, NULL, seat->goo_file_drag_serial);
+    WAYLAND_wl_display_flush(display->display);
+    return true;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_CancelFileDrag(SDL_Window *window)
+{
+    if (!window || SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0) {
+        return;
+    }
+    SDL_WaylandDataSource *source = SDL_GetPointerProperty(
+        SDL_GetWindowProperties(window), "Goo.FileDrag.1", NULL);
+    if (source) {
+        Goo_FinishFileDrag(source, false);
+    }
+}
 
