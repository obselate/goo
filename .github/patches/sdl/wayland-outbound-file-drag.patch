+static void Goo_FinishFileDrag(SDL_WaylandDataSource *source, bool accepted)
+{
+    void (SDLCALL *callback)(void *, bool) = source->goo_drag_finished;
+    void *userdata = source->goo_drag_userdata;
+    SDL_Window *window = source->goo_drag_window;
+    if (window) {
+        SDL_PropertiesID props = SDL_GetWindowProperties(window);
+        if (SDL_GetPointerProperty(props, "Goo.FileDrag.1", NULL) == source) {
+            SDL_ClearProperty(props, "Goo.FileDrag.1");
+        }
+    }
+    if (source->data_device && source->data_device->goo_drag_source == source) {
+        source->data_device->goo_drag_source = NULL;
+    }
+    Wayland_data_source_destroy(source);
+    if (callback) {
+        callback(userdata, accepted);
+    }
+}
