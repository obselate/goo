+static void Goo_SetForeignModal(SDL_WindowData *wind, bool modal)
+{
+    struct xdg_toplevel *toplevel = GetToplevelForWindow(wind);
+    SDL_VideoData *display = wind->waylandData;
+    if (toplevel && display->xdg_wm_dialog_v1) {
+        if (modal) {
+            if (!wind->xdg_dialog_v1) {
+                wind->xdg_dialog_v1 = xdg_wm_dialog_v1_get_xdg_dialog(display->xdg_wm_dialog_v1, toplevel);
+            }
+            if (wind->xdg_dialog_v1) {
+                xdg_dialog_v1_set_modal(wind->xdg_dialog_v1);
+            }
+        } else if (wind->xdg_dialog_v1) {
+            xdg_dialog_v1_unset_modal(wind->xdg_dialog_v1);
+        }
+    }
+}
+
+static void Goo_DestroyForeignParent(SDL_WindowData *wind)
+{
+    if (wind->goo_foreign_parent) {
+        zxdg_imported_v2_destroy(wind->goo_foreign_parent);
+        wind->goo_foreign_parent = NULL;
+    }
+}
+
+static void Goo_ForeignParentDestroyed(void *userdata, struct zxdg_imported_v2 *imported)
+{
+    SDL_WindowData *wind = userdata;
+    SDL_PropertiesID props = SDL_GetWindowProperties(wind->sdlwindow);
+    if (wind->goo_foreign_parent == imported) {
+        Goo_SetForeignModal(wind, false);
+        Goo_DestroyForeignParent(wind);
+        SDL_ClearProperty(props, "Goo.ForeignParent.Handle.1");
+        SDL_ClearProperty(props, "Goo.ForeignParent.Modal.1");
+    }
+}
+
+static const struct zxdg_imported_v2_listener goo_foreign_parent_listener = {
+    Goo_ForeignParentDestroyed
+};
+
+static bool Goo_ApplyForeignParent(SDL_WindowData *wind)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(wind->sdlwindow);
+    const char *handle = SDL_GetStringProperty(props, "Goo.ForeignParent.Handle.1", NULL);
+    if (!handle || wind->goo_foreign_parent || !GetToplevelForWindow(wind)) {
+        return true;
+    }
+    wind->goo_foreign_parent = zxdg_importer_v2_import_toplevel(wind->waylandData->zxdg_importer_v2, handle);
+    if (!wind->goo_foreign_parent) {
+        return false;
+    }
+    zxdg_imported_v2_add_listener(wind->goo_foreign_parent, &goo_foreign_parent_listener, wind);
+    zxdg_imported_v2_set_parent_of(wind->goo_foreign_parent, wind->surface);
+    Goo_SetForeignModal(wind, SDL_GetBooleanProperty(props, "Goo.ForeignParent.Modal.1", false));
+    return true;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_SetForeignParent(SDL_Window *window, const char *handle, Uint8 modal)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    if (!device || !window || !window->internal || SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0) {
+        return false;
+    }
+    SDL_WindowData *wind = window->internal;
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    if (!handle || !*handle) {
+        Goo_SetForeignModal(wind, false);
+        Goo_DestroyForeignParent(wind);
+        SDL_ClearProperty(props, "Goo.ForeignParent.Handle.1");
+        SDL_ClearProperty(props, "Goo.ForeignParent.Modal.1");
+        Wayland_SetWindowParent(device, window, window->parent);
+        if (window->parent && (window->flags & SDL_WINDOW_MODAL)) {
+            Wayland_SetWindowModal(device, window, true);
+        }
+        return true;
+    }
+    if (!wind->waylandData->zxdg_importer_v2 || window->parent ||
+        (wind->shell_surface_type != WAYLAND_SHELL_SURFACE_TYPE_XDG_TOPLEVEL &&
+         wind->shell_surface_type != WAYLAND_SHELL_SURFACE_TYPE_LIBDECOR) || SDL_strlen(handle) > 4096) {
+        return false;
+    }
+    for (const unsigned char *c = (const unsigned char *)handle; *c; ++c) {
+        if (*c < 32 || *c == 127) {
+            return false;
+        }
+    }
+    if (!SDL_SetStringProperty(props, "Goo.ForeignParent.Handle.1", handle) ||
+        !SDL_SetBooleanProperty(props, "Goo.ForeignParent.Modal.1", modal != 0)) {
+        return false;
+    }
+    Goo_SetForeignModal(wind, false);
+    Goo_DestroyForeignParent(wind);
+    return Goo_ApplyForeignParent(wind);
+}
