+static void GooPlacementLog(SDL_Window *window, NSWindow *nswindow, const char *phase)
+{
+    if (!SDL_getenv("GOO_PLACEMENT_DIAGNOSTICS")) { return; }
+    int w = 0, h = 0, pw = 0, ph = 0;
+    SDL_GetWindowSize(window, &w, &h);
+    SDL_GetWindowSizeInPixels(window, &pw, &ph);
+    NSLog(@"PLACEMENT %s id=%u frame=%@ content=%@ min=%@ max=%@ visible=%@ scale=%g SDL=%dx%d pixels=%dx%d requested=%dx%d flags=%llu", phase, window->id,
+        NSStringFromRect(nswindow.frame), NSStringFromRect([nswindow contentRectForFrameRect:nswindow.frame]),
+        NSStringFromSize(nswindow.contentMinSize), NSStringFromSize(nswindow.contentMaxSize),
+        NSStringFromRect(nswindow.screen.visibleFrame), nswindow.backingScaleFactor,
+        w, h, pw, ph, window->pending.w, window->pending.h, (unsigned long long)window->flags);
+}
+
 @implementation SDL_CocoaWindowData
 
 @end
