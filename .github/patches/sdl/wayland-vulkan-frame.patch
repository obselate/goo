+__attribute__((visibility("default"))) Uint64 SDLCALL Goo_WaylandVulkanGeometryVersion(SDL_Window *window)
+{
+    SDL_WindowData *wind = window->internal;
+    return Goo_UsesVulkanFrames(wind) ? wind->goo_geometry_version : 0;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_WaylandVulkanFrameReady(SDL_Window *window)
+{
+    SDL_WindowData *wind = window->internal;
+    if (Goo_UsesVulkanFrames(wind) && wind->goo_frame_pending &&
+        (wind->resizing || wind->goo_geometry_pending)) {
+        wind->goo_frame_waiting = true;
+        return false;
+    }
+    return true;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_PrepareWaylandVulkanFrame(SDL_Window *window)
+{
+    SDL_WindowData *wind = window->internal;
+    if (!Goo_UsesVulkanFrames(wind) || !wind->shell_surface.xdg.surface) {
+        return;
+    }
+
+    wind->goo_frame_commit_pending = true;
+    if (wind->goo_geometry_pending) {
+        const int width = wind->current.logical_width;
+        const int height = wind->current.logical_height;
+        if (wind->viewport) {
+            wp_viewport_set_destination(wind->viewport, width, height);
+        } else {
+            wl_surface_set_buffer_scale(wind->surface, wind->goo_buffer_scale);
+        }
+        xdg_surface_set_window_geometry(wind->shell_surface.xdg.surface, 0, 0, width, height);
+        SetSurfaceOpaqueRegion(wind, !(window->flags & SDL_WINDOW_TRANSPARENT) && window->opacity == 1.0f);
+        wind->goo_geometry_pending = false;
+    }
+    if (wind->pending_config_ack) {
+        xdg_surface_ack_configure(wind->shell_surface.xdg.surface, wind->shell_surface.xdg.serial);
+        wind->pending_config_ack = false;
+    }
+    wind->goo_frame_armed = !wind->goo_frame_pending;
+    if (!wind->goo_frame_armed) {
+        return;
+    }
+    if (!wind->surface_frame_callback) {
+        wind->surface_frame_callback = wl_surface_frame(wind->surface);
+        wl_callback_add_listener(wind->surface_frame_callback, &surface_frame_listener, wind);
+    }
+    wind->goo_frame_pending = true;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_FinishWaylandVulkanFrame(SDL_Window *window, bool committed)
+{
+    SDL_WindowData *wind = window->internal;
+    if (committed) {
+        wind->goo_frame_commit_pending = false;
+    } else if (wind->goo_frame_armed) {
+        wind->goo_frame_pending = false;
+    }
+    wind->goo_frame_armed = false;
+}
