+- (void)application:(NSApplication *)theApplication openFiles:(NSArray<NSString *> *)filenames
+{
+    bool accepted = true;
+    for (NSString *filename in filenames) {
+        if (!SDL_SendDropFile(NULL, NULL, [filename UTF8String])) {
+            accepted = false;
+        }
+    }
+    if (!SDL_SendDropComplete(NULL)) {
+        accepted = false;
+    }
+    [theApplication replyToOpenOrPrint:(accepted ? NSApplicationDelegateReplySuccess : NSApplicationDelegateReplyFailure)];
+}
