+__attribute__((visibility("default"))) const char * SDLCALL Goo_GetWaylandKeyboardLayoutName(void)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    if (!device || !device->internal || SDL_strcmp(device->name, "wayland") != 0) {
+        return NULL;
+    }
+    SDL_VideoData *display = device->internal;
+    SDL_WaylandSeat *seat;
+    const char *fallback = NULL;
+    wl_list_for_each (seat, &display->seat_list, link) {
+        const xkb_layout_index_t layout = seat->keyboard.xkb.current_layout;
+        if (!seat->keyboard.xkb.keymap || layout >= seat->keyboard.xkb.num_layouts) {
+            continue;
+        }
+        const char *name = WAYLAND_xkb_keymap_layout_get_name(seat->keyboard.xkb.keymap, layout);
+        if (seat->keyboard.focus) {
+            return name;
+        }
+        if (!fallback) { fallback = name; }
+    }
+    return fallback;
+}
 
