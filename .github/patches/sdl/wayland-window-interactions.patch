+        if (!SDL_RectEmpty(&window_data->sdlwindow->mouse_rect) && !seat->pointer.is_confined) {
+            Wayland_SeatUpdatePointerGrab(seat);
+        }
+
+        pointer_update_hit_test(seat);
+    }
