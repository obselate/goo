+static const char *goo_resize_border_tag = "goo-resize-border";
+
+static SDL_Rect Goo_ResizeBorderRect(SDL_WindowData *data, int edge)
+{
+    const int b = data->goo_border_size;
+    const int w = data->goo_border_width;
+    const int h = data->goo_border_height;
+    const int l = (data->goo_border_edges & 1) ? b : 0;
+    const int r = (data->goo_border_edges & 2) ? b : 0;
+    const SDL_Rect rects[4] = { { -b, 0, b, h }, { w, 0, b, h }, { -l, -b, w + l + r, b }, { -l, h, w + l + r, b } };
+    return rects[edge];
+}
+
+SDL_WindowData *Goo_GetResizeBorderWindow(struct wl_surface *surface, int *edge)
+{
+    if (wl_proxy_get_tag((struct wl_proxy *)surface) != &goo_resize_border_tag) {
+        return NULL;
+    }
+    SDL_WindowData *data = wl_surface_get_user_data(surface);
+    for (int i = 0; edge && i < 4; ++i) {
+        if (data->goo_border_surfaces[i] == surface) {
+            *edge = i + 1;
+        }
+    }
+    return data;
+}
+
+SDL_Point Goo_GetResizeBorderOrigin(SDL_WindowData *data, int edge)
+{
+    const SDL_Rect rect = edge ? Goo_ResizeBorderRect(data, edge - 1) : (SDL_Rect){ 0, 0, 0, 0 };
+    return (SDL_Point){ rect.x, rect.y };
+}
+
+static void Goo_UpdateResizeBorder(SDL_Window *window)
+{
+    SDL_WindowData *data = window->internal;
+    SDL_VideoData *video = data->waylandData;
+    if (!data->goo_border_geometry || !data->shell_surface.xdg.surface) {
+        return;
+    }
+    const int w = data->current.logical_width;
+    const int h = data->current.logical_height;
+    const bool floating = !data->is_fullscreen && !(window->flags & SDL_WINDOW_MAXIMIZED);
+    const int edges = data->goo_border_size > 0 && floating ? 15 & ~(data->goo_tiled_edges | data->toplevel_constraints) : 0;
+    xdg_surface_set_window_geometry(data->shell_surface.xdg.surface, 0, 0, w, h);
+    if (edges == data->goo_border_edges && w == data->goo_border_width && h == data->goo_border_height) {
+        return;
+    }
+    data->goo_border_edges = edges;
+    data->goo_border_width = w;
+    data->goo_border_height = h;
+
+    int size = 0;
+    for (int i = 0; i < 4; ++i) {
+        const SDL_Rect rect = Goo_ResizeBorderRect(data, i);
+        size += (edges & (1 << i)) ? rect.w * rect.h * 4 : 0;
+    }
+    Wayland_SHMPool *pool = Wayland_AllocSHMPool(size);
+    for (int i = 0; i < 4; ++i) {
+        const SDL_Rect rect = Goo_ResizeBorderRect(data, i);
+        Uint32 *pixels = NULL;
+        struct wl_buffer *buffer = (edges & (1 << i)) ? Wayland_AllocBufferFromPool(pool, rect.w, rect.h, (void **)&pixels) : NULL;
+        for (int y = 0; buffer && y < rect.h; ++y) {
+            for (int x = 0; x < rect.w; ++x) {
+                const float px = rect.x + x + 0.5f;
+                const float py = rect.y + y + 0.5f;
+                const float dx = SDL_max(SDL_max(-px, px - w), 0.0f);
+                const float dy = SDL_max(SDL_max(-py, py - h), 0.0f);
+                const float t = SDL_max(1.0f - SDL_sqrtf(dx * dx + dy * dy) / data->goo_border_size, 0.0f);
+                *pixels++ = (Uint32)(t * t * 0.32f * 255.0f + 0.5f) << 24;
+            }
+        }
+        if (!data->goo_border_surfaces[i]) {
+            if (!buffer) {
+                continue;
+            }
+            data->goo_border_surfaces[i] = wl_compositor_create_surface(video->compositor);
+            wl_proxy_set_tag((struct wl_proxy *)data->goo_border_surfaces[i], &goo_resize_border_tag);
+            wl_surface_set_user_data(data->goo_border_surfaces[i], data);
+            data->goo_border_subsurfaces[i] = wl_subcompositor_get_subsurface(video->subcompositor, data->goo_border_surfaces[i], data->surface);
+            wl_subsurface_place_below(data->goo_border_subsurfaces[i], data->surface);
+        }
+        wl_subsurface_set_position(data->goo_border_subsurfaces[i], rect.x, rect.y);
+        wl_surface_attach(data->goo_border_surfaces[i], buffer, 0, 0);
+        wl_surface_damage(data->goo_border_surfaces[i], 0, 0, rect.w, rect.h);
+        wl_surface_commit(data->goo_border_surfaces[i]);
+        if (data->goo_border_buffers[i]) {
+            wl_buffer_destroy(data->goo_border_buffers[i]);
+        }
+        data->goo_border_buffers[i] = buffer;
+    }
+    Wayland_ReleaseSHMPool(pool);
+}
+
+static void Goo_DestroyResizeBorder(SDL_WindowData *data)
+{
+    for (int i = 0; i < 4; ++i) {
+        if (data->goo_border_surfaces[i]) {
+            wl_subsurface_destroy(data->goo_border_subsurfaces[i]);
+            wl_surface_destroy(data->goo_border_surfaces[i]);
+        }
+        if (data->goo_border_buffers[i]) {
+            wl_buffer_destroy(data->goo_border_buffers[i]);
+        }
+    }
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_SetWindowResizeBorder(SDL_Window *window, int size)
+{
+    if (!SDL_GetVideoDevice() || !window || !window->internal || SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0 ||
+        window->internal->shell_surface_type != WAYLAND_SHELL_SURFACE_TYPE_XDG_TOPLEVEL || !window->internal->waylandData->subcompositor) {
+        return false;
+    }
+    window->internal->goo_border_size = SDL_max(size, 0);
+    window->internal->goo_border_geometry |= size > 0;
+    Goo_UpdateResizeBorder(window);
+    return true;
+}
