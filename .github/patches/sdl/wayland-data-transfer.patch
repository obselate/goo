+static int Goo_DataDragError(int status, const char *error)
+{
+    SDL_SetError("%s", error);
+    return status;
+}
+
+__attribute__((visibility("default"))) Uint32 SDLCALL Goo_GetDataTransferCapabilities(SDL_Window *window)
+{
+    SDL_VideoDevice *video = SDL_GetVideoDevice();
+    if (!video || !window || !window->internal || SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0) {
+        return 0;
+    }
+    SDL_VideoData *display = video->internal;
+    if (!display->data_device_manager) {
+        return 0;
+    }
+    return wl_data_device_manager_get_version(display->data_device_manager) >= 3 ? 31 : 3;
+}
+
+__attribute__((visibility("default"))) int SDLCALL Goo_StartDataDrag(SDL_Window *window,
+    const char **types, Uint32 count, Uint32 effects, void *native_object,
+    void (SDLCALL *send)(void *, const char *, int),
+    void (SDLCALL *completed)(void *, int, Uint32, Uint8), void *userdata)
+{
+    if (!(Goo_GetDataTransferCapabilities(window) & 4) || !send || !completed || !types || !count || !(effects & 3) || (effects & ~3)) {
+        return Goo_DataDragError(2, "Native MIME drag requires a Wayland v3 window and Copy or Move");
+    }
+    if (count > 128) {
+        return Goo_DataDragError(3, "Native drag exceeds 128 MIME types");
+    }
+    if (SDL_GetPointerProperty(SDL_GetWindowProperties(window), "Goo.DataDrag.1", NULL)) {
+        return Goo_DataDragError(5, "A native drag is already active");
+    }
+    SDL_VideoDevice *video = SDL_GetVideoDevice();
+    SDL_VideoData *display = video->internal;
+    SDL_WindowData *wind = window->internal;
+    SDL_WaylandSeat *seat;
+    wl_list_for_each (seat, &display->seat_list, link) {
+        if (seat->pointer.focus == wind &&
+            (seat->pointer.buttons_pressed & SDL_BUTTON_MASK(SDL_BUTTON_LEFT)) &&
+            seat->goo_drag_serial && seat->data_device && seat->data_device->data_device) {
+            break;
+        }
+    }
+    if (&seat->link == &display->seat_list) {
+        return Goo_DataDragError(4, "Native drag requires a held primary press on this window");
+    }
+    SDL_WaylandDataSource *source = Wayland_data_source_create(video);
+    if (!source) {
+        return 5;
+    }
+    source->data_device = seat->data_device;
+    source->goo_drag_window = window;
+    source->goo_drag_finished = completed;
+    source->goo_drag_send = send;
+    source->goo_drag_userdata = userdata;
+    if (!SDL_SetPointerProperty(SDL_GetWindowProperties(window), "Goo.DataDrag.1", source)) {
+        Wayland_data_source_destroy(source);
+        return 5;
+    }
+    seat->data_device->goo_drag_source = source;
+    for (Uint32 i = 0; i < count; ++i) {
+        wl_data_source_offer(source->source, types[i]);
+    }
+    wl_data_source_set_actions(source->source, effects);
+    wl_data_device_start_drag(seat->data_device->data_device, source->source,
+                              wind->surface, NULL, seat->goo_drag_serial);
+    WAYLAND_wl_display_flush(display->display);
+    return 0;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_CancelDataDrag(SDL_Window *window)
+{
+    if (window && SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") == 0) {
+        SDL_WaylandDataSource *source = SDL_GetPointerProperty(
+            SDL_GetWindowProperties(window), "Goo.DataDrag.1", NULL);
+        if (source) {
+            Goo_FinishDataDrag(source, 1);
+        }
+    }
+}
