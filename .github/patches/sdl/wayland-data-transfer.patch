+typedef Uint32 (SDLCALL *GooDropCallback)(void *, int, float, float, const char **, Uint32, Uint32, Uint64, void *);
+
+struct GooDataDropState {
+    SDL_Window *window;
+    GooDropCallback callback;
+    void *userdata;
+    char **types;
+    Uint32 count;
+    SDL_WaylandDataDevice *device;
+    SDL_WaylandDataOffer *offer;
+    Uint64 token;
+    int refs;
+    bool dropped;
+    bool finished;
+    float x, y;
+};
+
+static Uint64 goo_drop_token;
+
+static void Goo_ReleaseDrop(GooDataDropState *state)
+{
+    if (--state->refs == 0) {
+        for (Uint32 i = 0; i < state->count; ++i) {
+            SDL_free(state->types[i]);
+        }
+        SDL_free(state->types);
+        SDL_free(state);
+    }
+}
+
+static void Goo_ResetDrop(GooDataDropState *state, int kind)
+{
+    Uint64 token = state->token;
+    SDL_WaylandDataOffer *offer = state->offer;
+    SDL_WaylandDataDevice *device = state->device;
+    bool reject = state->dropped && !state->finished;
+    state->offer = NULL;
+    state->device = NULL;
+    state->token = 0;
+    state->dropped = false;
+    state->finished = false;
+    if (device) {
+        if (device->goo_drop == state) {
+            device->goo_drop = NULL;
+        }
+        if (device->drag_offer == offer) {
+            device->drag_offer = NULL;
+        }
+    }
+    if (offer) {
+        if (reject && device) {
+            wl_data_offer_accept(offer->offer, device->drag_serial, NULL);
+            if (wl_data_offer_get_version(offer->offer) >= 3) {
+                wl_data_offer_set_actions(offer->offer, 0, 0);
+            }
+        }
+        Wayland_data_offer_destroy(offer);
+        if (reject && device) {
+            WAYLAND_wl_display_flush(device->seat->display->display);
+        }
+    }
+    if (kind && token && state->callback) {
+        state->callback(state->userdata, kind, 0, 0, NULL, 0, 0, token, NULL);
+    }
+}
+
+static void Goo_CancelDrop(GooDataDropState *state, int kind)
+{
+    ++state->refs;
+    Goo_ResetDrop(state, kind);
+    Goo_ReleaseDrop(state);
+}
+
+static void SDLCALL Goo_DestroyDrop(void *userdata, void *value)
+{
+    GooDataDropState *state = value;
+    state->window = NULL;
+    Goo_CancelDrop(state, 4);
+    Goo_ReleaseDrop(state);
+}
+
+static Uint32 Goo_UpdateDrop(GooDataDropState *state, int kind, float x, float y)
+{
+    ++state->refs;
+    Uint64 token = state->token;
+    Uint32 selected = 0;
+    if (state->window && state->offer && state->callback) {
+        const char *types[128];
+        Uint32 count = 0;
+        for (Uint32 i = 0; i < state->count; ++i) {
+            if (Wayland_data_offer_has_mime(state->offer, state->types[i])) {
+                types[count++] = state->types[i];
+            }
+        }
+        state->x = x;
+        state->y = y;
+        Uint32 allowed = (kind == 3 ? state->offer->goo_action : state->offer->goo_source_actions) & 3;
+        SDL_WaylandDataSource *source = state->device->goo_drag_source;
+        selected = state->callback(state->userdata, kind, x, y, types, count, allowed, token,
+                                   source ? source->goo_drag_userdata : NULL) & allowed;
+        if (selected != 1 && selected != 2) {
+            selected = 0;
+        }
+        if (state->window && state->offer && state->token == token) {
+            if (kind != 3) {
+                wl_data_offer_accept(state->offer->offer, state->device->drag_serial, selected && count ? types[0] : NULL);
+                wl_data_offer_set_actions(state->offer->offer, selected, selected);
+                WAYLAND_wl_display_flush(state->device->seat->display->display);
+            } else if (!selected) {
+                Goo_ResetDrop(state, 4);
+            }
+        }
+    }
+    Goo_ReleaseDrop(state);
+    return selected;
+}
+
+static bool Goo_EnterDrop(SDL_WaylandDataDevice *device, SDL_Window *window, SDL_WaylandDataOffer *offer, float x, float y)
+{
+    GooDataDropState *state = SDL_GetPointerProperty(SDL_GetWindowProperties(window), "Goo.DataDrop.1", NULL);
+    if (!state) {
+        if (device->goo_drag_source) {
+            wl_data_offer_accept(offer->offer, device->drag_serial, NULL);
+            wl_data_offer_set_actions(offer->offer, 0, 0);
+            return true;
+        }
+        return false;
+    }
+    ++state->refs;
+    if (device->goo_drop) {
+        Goo_CancelDrop(device->goo_drop, 4);
+    }
+    if (state->offer) {
+        Goo_CancelDrop(state, 4);
+    }
+    if (state->window) {
+        state->device = device;
+        state->offer = offer;
+        state->token = ++goo_drop_token;
+        device->goo_drop = state;
+        Goo_UpdateDrop(state, 1, x, y);
+    }
+    Goo_ReleaseDrop(state);
+    return true;
+}
+
+__attribute__((visibility("default"))) Uint8 SDLCALL Goo_SetDataDropCallback(SDL_Window *window,
+    GooDropCallback callback, void *userdata, const char **types, Uint32 count)
+{
+    if (!(Goo_GetDataTransferCapabilities(window) & 16) || count > 128 || (count && !types)) {
+        return 0;
+    }
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    if (!callback) {
+        SDL_ClearProperty(props, "Goo.DataDrop.1");
+        return 1;
+    }
+    GooDataDropState *state = SDL_calloc(1, sizeof(*state));
+    if (!state) {
+        return 0;
+    }
+    state->refs = 1;
+    state->window = window;
+    state->callback = callback;
+    state->userdata = userdata;
+    state->types = SDL_calloc(count ? count : 1, sizeof(char *));
+    if (!state->types) {
+        Goo_ReleaseDrop(state);
+        return 0;
+    }
+    for (Uint32 i = 0; i < count; ++i) {
+        state->types[i] = SDL_strdup(types[i]);
+        if (!state->types[i]) {
+            Goo_ReleaseDrop(state);
+            return 0;
+        }
+        ++state->count;
+    }
+    if (!SDL_SetPointerPropertyWithCleanup(props, "Goo.DataDrop.1", state, Goo_DestroyDrop, NULL)) {
+        Goo_ReleaseDrop(state);
+        return 0;
+    }
+    return 1;
+}
+
+__attribute__((visibility("default"))) int SDLCALL Goo_ReceiveDataDrop(SDL_Window *window, Uint64 token, const char *type)
+{
+    GooDataDropState *state = SDL_GetPointerProperty(SDL_GetWindowProperties(window), "Goo.DataDrop.1", NULL);
+    if (!state || !state->offer || !state->dropped || state->token != token || !Wayland_data_offer_has_mime(state->offer, type)) {
+        return -1;
+    }
+    int descriptors[2];
+    if (pipe2(descriptors, O_CLOEXEC | O_NONBLOCK) < 0) {
+        return -1;
+    }
+    wl_data_offer_receive(state->offer->offer, type, descriptors[1]);
+    close(descriptors[1]);
+    WAYLAND_wl_display_flush(state->device->seat->display->display);
+    return descriptors[0];
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_FinishDataDrop(SDL_Window *window, Uint64 token, Uint32 effect)
+{
+    GooDataDropState *state = SDL_GetPointerProperty(SDL_GetWindowProperties(window), "Goo.DataDrop.1", NULL);
+    if (!state || !state->offer || !state->dropped || state->token != token) {
+        return;
+    }
+    if ((effect == 1 || effect == 2) && effect == state->offer->goo_action) {
+        state->finished = true;
+        wl_data_offer_finish(state->offer->offer);
+        WAYLAND_wl_display_flush(state->device->seat->display->display);
+    }
+    Goo_CancelDrop(state, 0);
+}
