@@ -1842,6 +1842,21 @@ static struct wl_callback_listener show_hide_sync_listener = {
     show_hide_sync_handler
 };
 
+static bool Wayland_ApplyGooActivationToken(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    static const char property[] = "Goo.Wayland.ActivationToken.1";
+    SDL_VideoData *data = _this->internal;
+    SDL_WindowData *wind = window->internal;
+    SDL_PropertiesID properties = SDL_GetWindowProperties(window);
+    const char *token = SDL_GetStringProperty(properties, property, NULL);
+    if (!token || !data->activation_manager) {
+        return false;
+    }
+    xdg_activation_v1_activate(data->activation_manager, token, wind->surface);
+    SDL_ClearProperty(properties, property);
+    return true;
+}
+
 static void exported_handle_handler(void *data, struct zxdg_exported_v2 *zxdg_exported_v2, const char *handle)
 {
     SDL_WindowData *wind = (SDL_WindowData *)data;
