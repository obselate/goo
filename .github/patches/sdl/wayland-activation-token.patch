          */
@@ -2325,6 +2340,9 @@ static void Wayland_activate_window(SDL_VideoData *data, SDL_WindowData *target_
 
 void Wayland_RaiseWindow(SDL_VideoDevice *_this, SDL_Window *window)
 {
+    if (Wayland_ApplyGooActivationToken(_this, window)) {
+        return;
+    }
     Wayland_activate_window(_this->internal, window->internal, true);
 }
 
