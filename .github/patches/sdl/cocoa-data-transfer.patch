--- /dev/null
+++ b/src/video/cocoa/SDL_cocoadatatransfer.m
@@ -0,0 +1,304 @@
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_COCOA
+
+#include "SDL_cocoavideo.h"
+#include "SDL_cocoadatatransfer.h"
+#include <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+typedef Uint32 (SDLCALL *Goo_CocoaDropCallback)(void *, int, float, float, const char **, Uint32, Uint32, Uint64, void *);
+typedef void (SDLCALL *Goo_CocoaDragCompleted)(void *, Sint32, Uint32, Uint8);
+typedef void (SDLCALL *Goo_CocoaDragService)(void *);
+
+typedef struct Goo_CocoaDragOffer {
+    void *writers;
+    Goo_CocoaDragService service;
+} Goo_CocoaDragOffer;
+
+@class Goo_CocoaDragSource;
+
+@interface Goo_CocoaDataTransfer : NSObject
+@property(nonatomic) Goo_CocoaDropCallback callback;
+@property(nonatomic) void *userdata;
+@property(nonatomic) Uint64 token;
+@property(nonatomic) NSInteger sequence;
+@property(nonatomic) Uint32 allowed;
+@property(nonatomic) Uint32 committed;
+@property(nonatomic) BOOL dropping;
+@property(nonatomic, strong) NSArray<NSPasteboardType> *types;
+@property(nonatomic, strong) Goo_CocoaDragSource *source;
+@end
+
+@implementation Goo_CocoaDataTransfer
+@end
+
+@interface Goo_CocoaDragSource : NSObject<NSDraggingSource>
+@property(nonatomic) Goo_CocoaDragCompleted completed;
+@property(nonatomic) Goo_CocoaDragService service;
+@property(nonatomic) void *userdata;
+@property(nonatomic) void *lifetime;
+@property(nonatomic) Uint32 effects;
+@property(nonatomic) BOOL cancelled;
+@property(nonatomic) BOOL files;
+@property(nonatomic) BOOL servicing;
+@property(nonatomic, weak) Goo_CocoaDataTransfer *owner;
+@property(nonatomic, strong) NSTimer *timer;
+- (void)serviceTimer:(NSTimer *)timer;
+@end
+
+@implementation Goo_CocoaDragSource
+- (NSDragOperation)draggingSession:(NSDraggingSession *)session sourceOperationMaskForDraggingContext:(NSDraggingContext)context
+{
+    (void)session;
+    (void)context;
+    if (self.cancelled) return NSDragOperationNone;
+    return ((self.effects & 1) ? NSDragOperationCopy : 0) | ((self.effects & 2) ? NSDragOperationMove : 0);
+}
+
+- (BOOL)ignoreModifierKeysForDraggingSession:(NSDraggingSession *)session
+{
+    (void)session;
+    return NO;
+}
+
+- (void)serviceTimer:(NSTimer *)timer
+{
+    (void)timer;
+    Goo_CocoaDragSource *keep = self;
+    if (!keep.service || keep.servicing) return;
+    keep.servicing = YES;
+    keep.service(keep.userdata);
+    keep.servicing = NO;
+}
+
+- (void)draggingSession:(NSDraggingSession *)session endedAtPoint:(NSPoint)point operation:(NSDragOperation)operation
+{
+    (void)session;
+    (void)point;
+    Goo_CocoaDragSource *keep = self;
+    Goo_CocoaDragCompleted completed = keep.completed;
+    void *userdata = keep.userdata;
+    void *lifetime = keep.lifetime;
+    keep.completed = NULL;
+    keep.service = NULL;
+    keep.userdata = NULL;
+    keep.lifetime = NULL;
+    [keep.timer invalidate];
+    keep.timer = nil;
+    Goo_CocoaDataTransfer *owner = keep.owner;
+    if (owner.source == keep) owner.source = nil;
+    const Uint32 effect = (operation & NSDragOperationMove) ? 2 : (operation & NSDragOperationCopy) ? 1 : 0;
+    if (completed) completed(userdata, effect ? 0 : 1, effect, effect == 2 && !keep.files);
+    if (lifetime) CFRelease(lifetime);
+}
+@end
+
+static Goo_CocoaDataTransfer *Goo_CocoaTransfer(SDL_Window *window, bool create)
+{
+    if (!window || !window->internal) return nil;
+    SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+    Goo_CocoaDataTransfer *transfer = data.goo_transfer;
+    if (!transfer && create) {
+        transfer = [Goo_CocoaDataTransfer new];
+        data.goo_transfer = transfer;
+    }
+    return transfer;
+}
+
+bool Cocoa_GooDataDropEnabled(SDL_Window *window)
+{
+    return Goo_CocoaTransfer(window, false).callback != NULL;
+}
+
+NSArray<NSPasteboardType> *Cocoa_GooDragTypes(SDL_Window *window)
+{
+    return Goo_CocoaTransfer(window, false).types;
+}
+
+void Cocoa_GooMouseEvent(SDL_Window *window, NSEvent *event)
+{
+    if (!window || !window->internal) return;
+    SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+    if (event.type == NSEventTypeLeftMouseDown || event.type == NSEventTypeLeftMouseDragged) {
+        data.goo_drag_event = event;
+    } else if (event.type == NSEventTypeLeftMouseUp) {
+        data.goo_drag_event = nil;
+    }
+}
+
+void Cocoa_GooDestroyDataTransfer(SDL_Window *window)
+{
+    Goo_CocoaDataTransfer *transfer = Goo_CocoaTransfer(window, false);
+    transfer.source.cancelled = YES;
+    transfer.source = nil;
+    transfer.callback = NULL;
+    transfer.userdata = NULL;
+    if (window && window->internal) {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+        data.goo_transfer = nil;
+        data.goo_drag_event = nil;
+    }
+}
+
+NSDragOperation Cocoa_GooDataDrop(SDL_Window *window, id<NSDraggingInfo> sender, int kind)
+{
+    Goo_CocoaDataTransfer *transfer = Goo_CocoaTransfer(window, false);
+    if (!transfer.callback) return NSDragOperationNone;
+    const NSDragOperation native = sender.draggingSourceOperationMask;
+    const Uint32 allowed = ((native & NSDragOperationCopy) ? 1 : 0) | ((native & NSDragOperationMove) ? 2 : 0);
+    if (kind != 2 && (kind == 0 || transfer.sequence != sender.draggingSequenceNumber || transfer.allowed != allowed)) {
+        transfer.token++;
+        if (!transfer.token) transfer.token++;
+        transfer.sequence = sender.draggingSequenceNumber;
+        transfer.allowed = allowed;
+    }
+    const NSPoint point = sender.draggingLocation;
+    const float x = (float)point.x;
+    const float y = (float)window->h - (float)point.y;
+    if (kind == 3) {
+        transfer.committed = 0;
+        transfer.dropping = YES;
+    }
+    const Uint32 selected = transfer.callback(transfer.userdata, kind, x, y, NULL, 0, allowed,
+        transfer.token, (__bridge void *)sender.draggingPasteboard);
+    transfer.dropping = NO;
+    const Uint32 effect = kind == 3 ? transfer.committed : selected;
+    return (effect & 2) ? NSDragOperationMove : (effect & 1) ? NSDragOperationCopy : NSDragOperationNone;
+}
+
+static NSString *Goo_CocoaRawType(const char *mime)
+{
+    const size_t length = SDL_strlen(mime);
+    char text[sizeof("io.github.obselate.goo.mime.") + 512];
+    const char hex[] = "0123456789ABCDEF";
+    size_t offset = SDL_strlcpy(text, "io.github.obselate.goo.mime.", sizeof(text));
+    for (size_t i = 0; i < length; ++i) {
+        const unsigned char value = (unsigned char)mime[i];
+        text[offset++] = hex[value >> 4];
+        text[offset++] = hex[value & 15];
+    }
+    text[offset] = 0;
+    return [NSString stringWithUTF8String:text];
+}
+
+__attribute__((visibility("default"))) Uint32 SDLCALL Goo_GetDataTransferCapabilities(SDL_Window *window)
+{
+    const char *driver = SDL_GetCurrentVideoDriver();
+    return window && window->internal && driver && SDL_strcmp(driver, "cocoa") == 0 ? 31 : 0;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_SetDataDropCallback(SDL_Window *window, Goo_CocoaDropCallback callback,
+    void *userdata, const char **types, Uint32 count)
+{
+    if (!Goo_GetDataTransferCapabilities(window) || count > 128) return SDL_SetError("Invalid Cocoa data drop configuration");
+    @autoreleasepool {
+        Goo_CocoaDataTransfer *transfer = Goo_CocoaTransfer(window, true);
+        NSMutableArray<NSPasteboardType> *native = [NSMutableArray arrayWithCapacity:count * 2];
+        for (Uint32 i = 0; i < count; ++i) {
+            if (!types || !types[i] || SDL_strlen(types[i]) > 256) return SDL_SetError("Invalid Cocoa MIME name");
+            NSString *name = [NSString stringWithUTF8String:types[i]];
+            [native addObject:Goo_CocoaRawType(types[i])];
+            if ([name isEqualToString:@"text/uri-list"]) {
+                [native addObject:NSPasteboardTypeFileURL];
+                [native addObject:NSFilenamesPboardType];
+            } else if ([name isEqualToString:@"text/plain"] || [name isEqualToString:@"text/plain;charset=utf-8"]) {
+                [native addObject:NSPasteboardTypeString];
+                [native addObject:@"public.utf16-plain-text"];
+                [native addObject:@"public.utf16-external-plain-text"];
+            } else if ([name isEqualToString:@"text/rtf"] || [name isEqualToString:@"application/rtf"]) {
+                [native addObject:NSPasteboardTypeRTF];
+            } else {
+                UTType *type = [UTType typeWithMIMEType:name];
+                if (type) [native addObject:type.identifier];
+            }
+        }
+        transfer.types = native;
+        transfer.callback = callback;
+        transfer.userdata = userdata;
+        Cocoa_AcceptDragAndDrop(window, callback || SDL_EventEnabled(SDL_EVENT_DROP_FILE) || SDL_EventEnabled(SDL_EVENT_DROP_TEXT));
+        return true;
+    }
+}
+
+__attribute__((visibility("default"))) int SDLCALL Goo_ReceiveDataDrop(SDL_Window *window, Uint64 token, const char *mime)
+{
+    (void)window;
+    (void)token;
+    (void)mime;
+    SDL_SetError("Cocoa drag data uses a borrowed pasteboard");
+    return -1;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_FinishDataDrop(SDL_Window *window, Uint64 token, Uint32 effect)
+{
+    Goo_CocoaDataTransfer *transfer = Goo_CocoaTransfer(window, false);
+    if (transfer.dropping && transfer.token == token) transfer.committed = effect & transfer.allowed & 3;
+}
+
+__attribute__((visibility("default"))) void SDLCALL Goo_CancelDataDrag(SDL_Window *window)
+{
+    Goo_CocoaTransfer(window, false).source.cancelled = YES;
+}
+
+__attribute__((visibility("default"))) Uint32 SDLCALL Goo_StartDataDrag(SDL_Window *window, const char **types, Uint32 count,
+    Uint32 effects, void *native_offer, void *send, Goo_CocoaDragCompleted completed, void *userdata)
+{
+    (void)types;
+    (void)send;
+    if (!Goo_GetDataTransferCapabilities(window) || !native_offer || !completed || !count || count > 128 || !(effects & 3)) {
+        SDL_SetError("Invalid Cocoa drag source configuration");
+        return 5;
+    }
+    @autoreleasepool {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+        Goo_CocoaDataTransfer *transfer = Goo_CocoaTransfer(window, true);
+        if (transfer.source) {
+            SDL_SetError("A Cocoa drag is already active");
+            return 5;
+        }
+        NSEvent *event = data.goo_drag_event;
+        if (!event || event.window != data.nswindow || !([NSEvent pressedMouseButtons] & 1)) return 1;
+        Goo_CocoaDragOffer *offer = native_offer;
+        NSArray<id<NSPasteboardWriting>> *writers = (__bridge NSArray *)offer->writers;
+        if (!writers.count || writers.count > 4097 || !data.nswindow.contentView) return 1;
+        NSMutableArray<NSDraggingItem *> *items = [NSMutableArray arrayWithCapacity:writers.count];
+        NSView *view = data.nswindow.contentView;
+        const NSPoint point = [view convertPoint:event.locationInWindow fromView:nil];
+        BOOL files = NO;
+        for (id<NSPasteboardWriting> writer in writers) {
+            if ([(NSObject *)writer isKindOfClass:[NSURL class]]) files = YES;
+            NSDraggingItem *item = [[NSDraggingItem alloc] initWithPasteboardWriter:writer];
+            [item setDraggingFrame:NSMakeRect(point.x, point.y, 24, 24) contents:[NSImage imageNamed:NSImageNameMultipleDocuments]];
+            [items addObject:item];
+        }
+        Goo_CocoaDragSource *source = [Goo_CocoaDragSource new];
+        source.completed = completed;
+        source.service = offer->service;
+        source.userdata = userdata;
+        source.effects = effects & 3;
+        source.files = files;
+        source.owner = transfer;
+        source.lifetime = (void *)CFBridgingRetain(source);
+        transfer.source = source;
+        source.timer = [NSTimer timerWithTimeInterval:0.016 target:source selector:@selector(serviceTimer:) userInfo:nil repeats:YES];
+        [[NSRunLoop mainRunLoop] addTimer:source.timer forMode:NSRunLoopCommonModes];
+        [[NSRunLoop mainRunLoop] addTimer:source.timer forMode:NSEventTrackingRunLoopMode];
+        NSDraggingSession *session = nil;
+        NSString *failure = nil;
+        @try { session = [view beginDraggingSessionWithItems:items event:event source:source]; }
+        @catch (NSException *error) { failure = error.reason; }
+        if (!session) {
+            [source.timer invalidate];
+            source.timer = nil;
+            transfer.source = nil;
+            if (source.lifetime) CFRelease(source.lifetime);
+            source.lifetime = NULL;
+            SDL_SetError("%s", failure.UTF8String ?: "AppKit did not create a dragging session");
+            return 5;
+        }
+        session.animatesToStartingPositionsOnCancelOrFail = NO;
+        return 0;
+    }
+}
+
+#endif
