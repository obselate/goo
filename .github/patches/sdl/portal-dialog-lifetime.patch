+/* Goo always uses an owner-aware, cancellable portal on Linux. */
+__attribute__((visibility("default"))) void SDLCALL Goo_ShowPortalFileDialog(SDL_FileDialogType type,
+    SDL_DialogFileCallback callback, void *userdata, SDL_PropertiesID props)
+{
+    if (!SDL_Portal_detect()) {
+        SDL_Unsupported();
+        callback(userdata, NULL, -1);
+        return;
+    }
+    SDL_Portal_ShowFileDialogWithProperties(type, callback, userdata, props);
+}
