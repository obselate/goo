+/* Goo extension: only call on the SDL event thread with a live owner. */
+__attribute__((visibility("default"))) void SDLCALL Goo_CancelFileDialog(SDL_Window *window)
+{
+    SDL_DBusContext *dbus = SDL_DBus_GetContext();
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    SignalCallback *data = SDL_GetPointerProperty(props, GOO_DIALOG_PROPERTY, NULL);
+    if (!data || !dbus) {
+        return;
+    }
+    SDL_ClearProperty(props, GOO_DIALOG_PROPERTY);
+    dbus->connection_remove_filter(dbus->session_conn, &DBus_MessageFilter, data);
+    dbus->bus_remove_match(dbus->session_conn, data->match, NULL);
+    DBusMessage *message = dbus->message_new_method_call(PORTAL_DESTINATION, data->path,
+                                                       SIGNAL_INTERFACE, "Close");
+    if (message) {
+        dbus->connection_send(dbus->session_conn, message, NULL);
+        dbus->message_unref(message);
+        dbus->connection_flush(dbus->session_conn);
+    }
+    const char *empty[] = { NULL };
+    data->callback(data->userdata, empty, -1);
+    SDL_free(data->match);
+    SDL_free((void *)data->path);
+    SDL_free(data);
+}
