+#define GOO_POPUP_INPUT_CAPACITY 256
+typedef struct Goo_PopupInput {
+    Uint64 timestamp;
+    SDL_WindowID window;
+    SDL_WaylandSeat *seat;
+    Uint32 serial;
+} Goo_PopupInput;
+static Goo_PopupInput goo_popup_inputs[GOO_POPUP_INPUT_CAPACITY];
+static unsigned int goo_popup_input_index;
+
+static void Goo_RecordPopupInput(SDL_Window *window, SDL_WaylandSeat *seat, Uint64 timestamp)
+{
+    if (window && timestamp) {
+        Goo_PopupInput *input = &goo_popup_inputs[goo_popup_input_index++ % GOO_POPUP_INPUT_CAPACITY];
+        *input = (Goo_PopupInput){ timestamp, window->id, seat, seat->last_implicit_grab_serial };
+    }
+}
+
+static SDL_WaylandSeat *Goo_LivePopupSeat(SDL_WaylandSeat *expected)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    SDL_VideoData *display = device->internal;
+    SDL_WaylandSeat *seat;
+    wl_list_for_each (seat, &display->seat_list, link) {
+        if (seat == expected) {
+            return seat;
+        }
+    }
+    return NULL;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL Goo_ConfigurePopup(SDL_Window *parent, SDL_Window *popup,
+    Uint64 timestamp, int x, int y, int width, int height, int placement)
+{
+    if (!parent || !popup || SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0 ||
+        popup->parent != parent || !SDL_WINDOW_IS_POPUP(popup) || width <= 0 || height <= 0 ||
+        placement < 0 || placement > 11) {
+        return SDL_SetError("Invalid native popup owner or anchor");
+    }
+    SDL_PropertiesID props = SDL_GetWindowProperties(popup);
+    struct xdg_popup *mapped = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WAYLAND_XDG_POPUP_POINTER, NULL);
+    if (mapped && xdg_popup_get_version(mapped) < XDG_POPUP_REPOSITION_SINCE_VERSION) {
+        return SDL_SetError("The compositor cannot reposition native popups");
+    }
+    if (x < 0 || y < 0 || x > parent->w - width || y > parent->h - height) {
+        return SDL_SetError("The popup anchor must be inside its parent");
+    }
+    if (!SDL_SetNumberProperty(props, "Goo.Popup.X", x) ||
+        !SDL_SetNumberProperty(props, "Goo.Popup.Y", y) ||
+        !SDL_SetNumberProperty(props, "Goo.Popup.Width", width) ||
+        !SDL_SetNumberProperty(props, "Goo.Popup.Height", height) ||
+        !SDL_SetNumberProperty(props, "Goo.Popup.Placement", placement)) {
+        return false;
+    }
+    if ((popup->flags & SDL_WINDOW_TOOLTIP) || SDL_GetBooleanProperty(props, "Goo.Popup.Grabbed", false)) {
+        return true;
+    }
+    SDL_WaylandSeat *seat = NULL;
+    Uint32 serial = 0;
+    if (timestamp) {
+        for (unsigned int i = 0; i < GOO_POPUP_INPUT_CAPACITY; ++i) {
+            Goo_PopupInput *input = &goo_popup_inputs[i];
+            if (input->timestamp == timestamp && input->window == parent->id) {
+                seat = Goo_LivePopupSeat(input->seat);
+                serial = input->serial;
+                break;
+            }
+        }
+    }
+    if (!seat && SDL_GetBooleanProperty(SDL_GetWindowProperties(parent), "Goo.Popup.Grabbed", false)) {
+        seat = Goo_LivePopupSeat(SDL_GetPointerProperty(SDL_GetWindowProperties(parent), "Goo.Popup.Seat", NULL));
+        serial = (Uint32)SDL_GetNumberProperty(SDL_GetWindowProperties(parent), "Goo.Popup.Serial", 0);
+    }
+    if (!seat || !serial || (SDL_WINDOW_IS_POPUP(parent) &&
+        !SDL_GetBooleanProperty(SDL_GetWindowProperties(parent), "Goo.Popup.Grabbed", false))) {
+        return SDL_SetError("A popup menu requires native input or an active parent popup grab");
+    }
+    return SDL_SetPointerProperty(props, "Goo.Popup.Seat", seat) &&
+        SDL_SetNumberProperty(props, "Goo.Popup.Serial", serial);
+}
+
+void Goo_GrabPopup(SDL_Window *window, struct xdg_popup *popup)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    SDL_WaylandSeat *seat = Goo_LivePopupSeat(SDL_GetPointerProperty(props, "Goo.Popup.Seat", NULL));
+    Uint32 serial = (Uint32)SDL_GetNumberProperty(props, "Goo.Popup.Serial", 0);
+    if (seat && serial) {
+        xdg_popup_grab(popup, seat->wl_seat, serial);
+        SDL_SetBooleanProperty(props, "Goo.Popup.Grabbed", true);
+    }
+}
 
