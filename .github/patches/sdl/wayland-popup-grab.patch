+static void Goo_PositionPopup(SDL_Window *window, struct xdg_positioner *positioner)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    if (!SDL_HasProperty(props, "Goo.Popup.Placement")) {
+        return;
+    }
+    const int placement = (int)SDL_GetNumberProperty(props, "Goo.Popup.Placement", 0);
+    int x = (int)SDL_GetNumberProperty(props, "Goo.Popup.X", 0);
+    int y = (int)SDL_GetNumberProperty(props, "Goo.Popup.Y", 0);
+    const int width = (int)SDL_GetNumberProperty(props, "Goo.Popup.Width", 1);
+    const int height = (int)SDL_GetNumberProperty(props, "Goo.Popup.Height", 1);
+    static const enum xdg_positioner_anchor anchors[] = {
+        XDG_POSITIONER_ANCHOR_BOTTOM_LEFT, XDG_POSITIONER_ANCHOR_BOTTOM, XDG_POSITIONER_ANCHOR_BOTTOM_RIGHT,
+        XDG_POSITIONER_ANCHOR_TOP_LEFT, XDG_POSITIONER_ANCHOR_TOP, XDG_POSITIONER_ANCHOR_TOP_RIGHT,
+        XDG_POSITIONER_ANCHOR_TOP_RIGHT, XDG_POSITIONER_ANCHOR_RIGHT, XDG_POSITIONER_ANCHOR_BOTTOM_RIGHT,
+        XDG_POSITIONER_ANCHOR_TOP_LEFT, XDG_POSITIONER_ANCHOR_LEFT, XDG_POSITIONER_ANCHOR_BOTTOM_LEFT
+    };
+    static const enum xdg_positioner_gravity gravities[] = {
+        XDG_POSITIONER_GRAVITY_BOTTOM_RIGHT, XDG_POSITIONER_GRAVITY_BOTTOM, XDG_POSITIONER_GRAVITY_BOTTOM_LEFT,
+        XDG_POSITIONER_GRAVITY_TOP_RIGHT, XDG_POSITIONER_GRAVITY_TOP, XDG_POSITIONER_GRAVITY_TOP_LEFT,
+        XDG_POSITIONER_GRAVITY_BOTTOM_RIGHT, XDG_POSITIONER_GRAVITY_RIGHT, XDG_POSITIONER_GRAVITY_TOP_RIGHT,
+        XDG_POSITIONER_GRAVITY_BOTTOM_LEFT, XDG_POSITIONER_GRAVITY_LEFT, XDG_POSITIONER_GRAVITY_TOP_LEFT
+    };
+    AdjustPopupOffset(window, &x, &y);
+    xdg_positioner_set_anchor_rect(positioner, x, y, width, height);
+    xdg_positioner_set_anchor(positioner, anchors[placement]);
+    xdg_positioner_set_gravity(positioner, gravities[placement]);
+    xdg_positioner_set_offset(positioner, 0, 0);
+    xdg_positioner_set_constraint_adjustment(positioner,
+        XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_FLIP_X | XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_FLIP_Y |
+        XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_X | XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_Y |
+        XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_RESIZE_X | XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_RESIZE_Y);
+}
