<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Goo.Audio</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>Optional UI cues and bounded audio primitives for Goo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <InternalsVisibleTo Include="Goo.AudioSmoke" />
    <PackageReference Include="Hexa.NET.SDL3" ExcludeAssets="native" />
    <None Include="../docs/audio.md" Pack="true" PackagePath="README.md" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="RegisterAudioDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
    </ItemGroup>
  </Target>
</Project>
