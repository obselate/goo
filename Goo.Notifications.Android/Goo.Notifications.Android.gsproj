<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(GooReleaseVersion)</Version>
    <PackageId>Goo.Notifications.Android</PackageId>
    <Description>Optional Android notifications for Goo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo.Android/Goo.Android.gsproj" />
    <ProjectReference Include="../Goo.Notifications/Goo.Notifications.gsproj" />
    <None Include="../docs/notifications.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <Target Name="NormalizeAndroidReferencePath" AfterTargets="_GsharpGetRefAssemblyForPack">
    <ItemGroup>
      <TfmSpecificPackageFile Update="$(TargetRefPath)" PackagePath="ref/$(TargetFramework)$(TargetPlatformVersion)/" />
    </ItemGroup>
  </Target>
  <Target Name="RegisterNotificationDocumentation" AfterTargets="CoreCompile">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <None Include="$(DocumentationFile)" Pack="true" PackagePath="lib/$(TargetFramework)$(TargetPlatformVersion)/Goo.Notifications.Android.xml" />
    </ItemGroup>
  </Target>
</Project>
