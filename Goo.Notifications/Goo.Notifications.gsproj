<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Goo</RootNamespace>
    <PackageId>Goo.Notifications</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>Optional native operating-system notifications for Goo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Goo.Notifications.Android" />
    <InternalsVisibleTo Include="Goo.Notifications.WindowsSmoke" />
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <None Include="../docs/notifications.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <Target Name="IncludeNotificationDocumentation" AfterTargets="CoreCompile"
          BeforeTargets="DocumentationProjectOutputGroup" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <DocumentationProjectOutputGroupOutput Include="@(DocFileItem->'%(FullPath)')"
          FinalOutputPath="@(DocFileItem->'%(FullPath)')" TargetPath="@(DocFileItem->'%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
