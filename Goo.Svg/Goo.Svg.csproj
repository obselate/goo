<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Svg</RootNamespace>
    <AssemblyName>Goo.Svg</AssemblyName>
    <PackageId>Goo.Svg</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>Optional runtime SVG loading for Goo.</Description>
    <PackageTags>goo;svg;vector;runtime</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/obselate/goo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <Compile Include="../tools/Goo.SvgCompiler/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../tools/Goo.SvgCompiler/SvgCompiler.*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../tools/Goo.SvgCompiler/SvgModel.cs" Link="SvgModel.cs" />
    <Compile Include="../tools/Goo.SvgCompiler/SvgPathParser.cs" Link="SvgPathParser.cs" />
    <Compile Include="../tools/Goo.SvgCompiler/SvgScanners.cs" Link="SvgScanners.cs" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
