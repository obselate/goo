<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Goo' or '$(MSBuildProjectName)' == 'Goo.ApiContractTests' or '$(MSBuildProjectName)' == 'Goo.CoreBehaviorTests' or '$(MSBuildProjectName)' == 'Goo.ImageLoadingTests'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageVersion Include="Hexa.NET.SDL3" Version="1.2.17" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Unicode.Bidi" Version="0.3.18" />
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
