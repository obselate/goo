<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>$(GooReleaseVersion)</Version>
    <PackageId>Goo.SpellCheck.Android</PackageId>
    <Description>Optional Android SpellCheckerSession backend for Goo.SpellCheck.</Description>
    <Authors>Xaz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo.SpellCheck/Goo.SpellCheck.gsproj" />
  </ItemGroup>
</Project>
