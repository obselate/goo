<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>$(GooReleaseVersion)</Version>
    <PackageId>Goo.SpellCheck.Hunspell</PackageId>
    <Description>Opt-in system Hunspell backend for Goo.SpellCheck. No bundled libraries or dictionaries.</Description>
    <Authors>Xaz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo.SpellCheck/Goo.SpellCheck.gsproj" />
  </ItemGroup>
  <Target Name="RegisterHunspellDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <None Include="$(DocumentationFile)" Pack="true" PackagePath="lib/$(TargetFramework)/Goo.SpellCheck.Hunspell.xml" />
    </ItemGroup>
  </Target>
</Project>
