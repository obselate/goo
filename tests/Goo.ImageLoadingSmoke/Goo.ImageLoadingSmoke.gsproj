<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" Condition="'$(GooImageUsePackages)' != 'true'" />
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)" Condition="'$(GooImageUsePackages)' == 'true'" />
    <GooAsset Include="../Shared/Assets/local-rgba.png" Link="Resources/local-rgba.png" />
    <Content Include="../Shared/Assets/local-rgba.png" Link="Assets/local-rgba.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Shared/Assets/local-profile.png" Link="Assets/local-profile.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Shared/Assets/local-*.jpg;../Shared/Assets/local-*.gif" Link="Assets/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../Goo/Goo.targets" Condition="'$(GooImageUsePackages)' != 'true'" />
</Project>
