<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.FSharpInterop</RootNamespace>
    <AssemblyName>Goo.FSharpInterop</AssemblyName>
    <GooCoreBehaviorFixturesPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Goo.CoreBehaviorTests/Goo.CoreBehaviorTestFixtures.props'))</GooCoreBehaviorFixturesPath>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FSharpInterop.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=CoreTestRelease;IncludeTestFixtures=true;GooTestFixturesProps=$(GooCoreBehaviorFixturesPath)" />
  </ItemGroup>
</Project>
