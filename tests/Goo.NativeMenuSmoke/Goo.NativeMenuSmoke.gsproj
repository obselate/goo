<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" Condition="'$(GooMenuUsePackages)' != 'true'" />
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)" Condition="'$(GooMenuUsePackages)' == 'true'" />
  </ItemGroup>
</Project>
