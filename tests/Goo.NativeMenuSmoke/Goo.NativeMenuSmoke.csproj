<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo.NativeMenus/Goo.NativeMenus.gsproj" Condition="'$(GooMenuUsePackages)' != 'true'" />
    <PackageReference Include="Goo.NativeMenus" Version="$(GooReleaseVersion)" Condition="'$(GooMenuUsePackages)' == 'true'" />
  </ItemGroup>
</Project>
