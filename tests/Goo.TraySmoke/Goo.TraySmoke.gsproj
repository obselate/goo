<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" Condition="'$(GooTrayUsePackages)' != 'true'" />
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)" Condition="'$(GooTrayUsePackages)' == 'true'" />
  </ItemGroup>
</Project>
