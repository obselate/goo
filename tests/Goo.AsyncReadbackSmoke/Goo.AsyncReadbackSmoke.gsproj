<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooAsyncReadbackSmoke</RootNamespace>
    <AssemblyName>Goo.AsyncReadbackSmoke</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <GooShaderEffect Include="Shaders/control_effect.frag.slang"
                     TargetPath="control_effect.frag.goo-effect" />
    <GooShaderEffect Include="../../apps/Goo.Gallery/Shaders/liquid_glass.frag.slang"
                     TargetPath="liquid_glass.frag.goo-effect" />
    <GooShaderEffect Include="../../apps/Goo.Gallery/Shaders/crt.frag.slang"
                     TargetPath="crt.frag.goo-effect" />
    <Compile Remove="WindowReadbackFixture.gs" />
    <Compile Remove="DiagnosticCaptureSmoke.gs" />
    <Compile Remove="EmbeddedHostSmoke.gs" />
    <Compile Remove="WindowActivationSmoke.gs" />
    <Compile Include="../Shared/PrimitiveScene.gs" Link="PrimitiveScene.gs" />
    <Compile Include="../Shared/RoundedOverflowScene.gs" Link="RoundedOverflowScene.gs" />
    <Compile Include="../Shared/EffectsScene.gs" Link="EffectsScene.gs" />
    <Content Include="../Shared/Assets/local-rgba.png" Link="local-rgba.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf"
             Link="VendSans-VariableFont_wght.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Goo.VulkanProof/Assets/Text/HarfBuzz-chromacheck-colr.ttf"
             Link="HarfBuzz-chromacheck-colr.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=AsyncReadbackTestRelease;IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.AsyncReadbackFixtures.props" />
    <ProjectReference Include="../../Goo.Svg/Goo.Svg.csproj"
                      AdditionalProperties="Configuration=AsyncReadbackTestRelease;IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.AsyncReadbackFixtures.props" />
  </ItemGroup>
  <Target Name="UseGooLinuxSdlForAsyncReadbackSmoke"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
    <Copy SourceFiles="$(GooLinuxSdlPath)"
          DestinationFiles="$(TargetDir)libSDL3.so" />
  </Target>
  <Import Project="../../Goo/Goo.targets" />
</Project>
