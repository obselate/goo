<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooPackageSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/PrimitiveScene.gs" Link="PrimitiveScene.gs" />
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)"
                      Condition="'$(GooUseProjectReference)' != 'true'" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      Condition="'$(GooUseProjectReference)' == 'true'" />
    <None Include="run-windows-qualification.ps1"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' and '$(GooMacOsArm64NativeRoot)' != ''">
    <Content Include="$(GooMacOsArm64NativeRoot)/libSDL3.dylib"
             Link="libSDL3.dylib"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(GooMacOsArm64NativeRoot)/libMoltenVK.dylib"
             Link="libMoltenVK.dylib"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz.dylib"
             Link="libgoo-harfbuzz.dylib"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz-gpu.dylib"
             Link="libgoo-harfbuzz-gpu.dylib"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(GooMacOsArm64NativeRoot)/text-native-build.json"
             Link="text-native-build.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
