<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooVulkanAbiSmoke</RootNamespace>
    <AssemblyName>Goo.VulkanAbiSmoke</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="TextShapingFixtures.gs;DescriptorLifetimeFixtures.gs;DescriptorLifetimeRegression.gs" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=TestRelease;IncludeTestFixtures=true" />
    <Content Include="../Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf"
             Link="VendSans-VariableFont_wght.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
