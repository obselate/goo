<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ApplicationId>org.goo.androidsmoke</ApplicationId>
    <ApplicationTitle>Goo Vulkan smoke</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidPackageFormats>apk;aab</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo.Android/Goo.Android.csproj" Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <PackageReference Include="Goo.Android" Version="$(GooReleaseVersion)" Condition="'$(GooSmokeUsePackages)' == 'true'" />
    <ProjectReference Include="../../Goo.NativeMenus/Goo.NativeMenus.gsproj" Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <PackageReference Include="Goo.NativeMenus" Version="$(GooReleaseVersion)" Condition="'$(GooSmokeUsePackages)' == 'true'" />
    <ProjectReference Include="../Goo.AndroidSmoke.Shared/Goo.AndroidSmoke.Shared.gsproj" />
    <ProjectReference Include="../../Goo.Gestures/Goo.Gestures.gsproj" Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <PackageReference Include="Goo.Gestures" Version="$(GooReleaseVersion)" Condition="'$(GooSmokeUsePackages)' == 'true'" />
  </ItemGroup>
</Project>
