<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.VulkanProof</RootNamespace>
    <AssemblyName>Goo.VulkanProof</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.gs" />
    <Compile Include="VulkanProofLauncher.gs" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=VulkanProofTestRelease;IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.VulkanProofFixtures.props" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Generated/Shaders/solid_quad.vert.spv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Generated/Shaders/solid_quad.frag.spv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/VendSans-VariableFont_wght.ttf" Link="VendSans-VariableFont_wght.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/VendSans-OFL.txt" Link="VendSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/VendSans.provenance.json" Link="VendSans.provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-chromacheck-colr.ttf" Link="HarfBuzz-chromacheck-colr.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/ChromaCheck-MIT.txt" Link="ChromaCheck-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-chromacheck-colr.provenance.json" Link="HarfBuzz-chromacheck-colr.provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-adwaita-colrv1.ttf" Link="HarfBuzz-adwaita-colrv1.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-adwaita-colrv1.provenance.json" Link="HarfBuzz-adwaita-colrv1.provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-TTC.ttc" Link="HarfBuzz-TTC.ttc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-TTC.provenance.json" Link="HarfBuzz-TTC.provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/Text/HarfBuzz-test-fonts-COPYING.txt" Link="HarfBuzz-test-fonts-COPYING.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <Content Include="Runtime/libgoo-harfbuzz.so" Link="libgoo-harfbuzz.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Runtime/libgoo-harfbuzz-gpu.so" Link="libgoo-harfbuzz-gpu.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Runtime/text-native-build.json" Link="text-native-build.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <Content Include="Runtime/win-x64/goo-harfbuzz.dll" Link="goo-harfbuzz.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Runtime/win-x64/goo-harfbuzz-gpu.dll" Link="goo-harfbuzz-gpu.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Runtime/win-x64/text-native-build.json" Link="text-native-build.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
