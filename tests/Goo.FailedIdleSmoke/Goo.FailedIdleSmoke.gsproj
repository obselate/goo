<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooFailedIdleSmoke</RootNamespace>
    <AssemblyName>Goo.FailedIdleSmoke</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FailedIdleFixture.gs" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=FailedIdleTestRelease;IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.FailedIdleFixtures.props" />
  </ItemGroup>
  <Target Name="UseGooLinuxSdlForFailedIdleSmoke"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
    <Copy SourceFiles="$(GooLinuxSdlPath)"
          DestinationFiles="$(TargetDir)libSDL3.so" />
  </Target>
</Project>
