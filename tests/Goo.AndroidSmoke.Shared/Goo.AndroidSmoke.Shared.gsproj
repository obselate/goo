<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)" Condition="'$(GooSmokeUsePackages)' == 'true'" />
    <EmbeddedResource Include="../Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf" LogicalName="Goo.AndroidSmoke.Font.ttf" />
  </ItemGroup>
</Project>
