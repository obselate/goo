<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Goo\Goo.gsproj"
                      Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <ProjectReference Include="../../Goo.NativeMenus/Goo.NativeMenus.gsproj"
                      Condition="'$(GooSmokeUsePackages)' != 'true'" />
    <PackageReference Include="Goo" VersionOverride="$(GooReleaseVersion)"
                      Condition="'$(GooSmokeUsePackages)' == 'true'" />
    <PackageReference Include="Goo.NativeMenus" VersionOverride="$(GooReleaseVersion)"
                      Condition="'$(GooSmokeUsePackages)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PublicApi.approved.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="PublicApi.approved.txt" />
  </ItemGroup>
</Project>
