<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo.Audio/Goo.Audio.gsproj" Condition="'$(GooUsePackageReference)' != 'true'" />
    <PackageReference Include="Goo.Audio" Version="$(GooReleaseVersion)" Condition="'$(GooUsePackageReference)' == 'true'" />
    <None Include="$(GooLinuxSdlPath)" Link="libSDL3.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(GooLinuxSdlPath)' != ''" />
  </ItemGroup>
</Project>
