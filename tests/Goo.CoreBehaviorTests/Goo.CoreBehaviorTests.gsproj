<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>Goo.CoreBehaviorTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.gs" />
    <Compile Include="../../tools/Goo.ShaderGen/ShaderSourceDigest.gs" Link="ShaderSourceDigest.gs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Goo.Accessibility\Goo.Accessibility.gsproj" />
    <ProjectReference Include="..\..\Goo\Goo.gsproj"
                      AdditionalProperties="Configuration=TestRelease;IncludeTestFixtures=true" />
    <ProjectReference Include="..\Goo.FSharpInterop\Goo.FSharpInterop.fsproj"
                      AdditionalProperties="Configuration=TestRelease" />
    <ProjectReference Include="..\Goo.AndroidSmoke.Shared\Goo.AndroidSmoke.Shared.gsproj"
                      AdditionalProperties="Configuration=TestRelease;IncludeTestFixtures=true" />
    <None Update="Assets/*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="UseGooLinuxSdlForTests"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
    <Copy SourceFiles="$(GooLinuxSdlPath)"
          DestinationFiles="$(TargetDir)libSDL3.so" />
  </Target>
</Project>
