<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooGestureSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)"
                      Condition="'$(GooUseProjectReference)' != 'true'" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      Condition="'$(GooUseProjectReference)' == 'true'" />
    <None Include="$(GooLinuxSdlPath)" Link="libSDL3.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(GooLinuxSdlPath)' != ''" />
  </ItemGroup>
</Project>
