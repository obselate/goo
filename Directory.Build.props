<Project>
  <PropertyGroup>
    <GsharpCompilerFullPath Condition="'$(GsharpCompilerFullPath)' == ''">$(MSBuildThisFileDirectory)artifacts/gsharp/compiler/gsc.dll</GsharpCompilerFullPath>
    <GooReleaseVersion>0.7.1</GooReleaseVersion>
    <GooLinuxSdlPath Condition="'$(GooLinuxSdlPath)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/linux-x64/native/libSDL3.so')">$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/linux-x64/native/libSDL3.so</GooLinuxSdlPath>
    <GooLinuxSdlStaticPath Condition="'$(GooLinuxSdlStaticPath)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/native/libSDL3.a')">$(MSBuildThisFileDirectory)artifacts/native/libSDL3.a</GooLinuxSdlStaticPath>
    <GooLinuxTextStaticRoot Condition="'$(GooLinuxTextStaticRoot)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/native/text/libgoo-harfbuzz.a')">$(MSBuildThisFileDirectory)artifacts/native/text</GooLinuxTextStaticRoot>
    <GooWindowsSdlPath Condition="'$(GooWindowsSdlPath)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/win-x64/native/SDL3.dll')">$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/win-x64/native/SDL3.dll</GooWindowsSdlPath>
    <GooMacOsArm64NativeRoot Condition="'$(GooMacOsArm64NativeRoot)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/osx-arm64/native/libSDL3.dylib')">$(MSBuildThisFileDirectory)artifacts/gallery-native/runtimes/osx-arm64/native</GooMacOsArm64NativeRoot>
  </PropertyGroup>
  <!-- Custom Release configurations still require optimized G# output. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(Configuration)').EndsWith('Release'))">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
