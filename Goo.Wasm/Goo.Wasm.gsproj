<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Goo.Wasm</AssemblyName>
    <RootNamespace>Goo.Wasm</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <EmbeddedResource Include="Shaders/*.wgsl" LogicalName="Goo.Wasm.Shaders.%(Filename)%(Extension)" />
    <ProjectReference Include="Interop/Goo.Wasm.Interop.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
