<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>$(GooReleaseVersion)</Version>
    <PackageId>Goo.SpellCheck</PackageId>
    <Description>Optional system spell checking and editor suggestions for Goo.</Description>
    <Authors>Xaz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <InternalsVisibleTo Include="Goo.SpellCheck.Hunspell" />
    <InternalsVisibleTo Include="Goo.SpellCheck.Android" />
  </ItemGroup>
  <Target Name="RegisterSpellingDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <None Include="$(DocumentationFile)" Pack="true" PackagePath="lib/$(TargetFramework)/Goo.SpellCheck.xml" />
    </ItemGroup>
  </Target>
</Project>
