<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Images</RootNamespace>
    <PackageId>Goo.Images</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>Scale-aware local image asset selection for Goo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo/Goo.gsproj" />
    <None Include="../docs/images.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <Target Name="CopyImageXmlDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
      <None Include="$(DocumentationFile)" Pack="true" PackagePath="lib/$(TargetFramework)/Goo.Images.xml" />
    </ItemGroup>
  </Target>
</Project>
