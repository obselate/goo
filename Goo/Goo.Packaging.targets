<Project>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeGooImplementationAssemblies</TargetsForTfmSpecificBuildOutput>
    <BeforePack>BuildGooShaderEffectToolForPackage;$(BeforePack)</BeforePack>
    <GooVulkanShaderRoot>$(MSBuildProjectDirectory)/Shaders/Vulkan</GooVulkanShaderRoot>
    <GooNativeRuntimeRoot>$(MSBuildProjectDirectory)/Runtime/Vulkan</GooNativeRuntimeRoot>
    <GooEffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GooEffectiveRuntimeIdentifier>
    <GooEffectiveRuntimeIdentifier Condition="'$(GooEffectiveRuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</GooEffectiveRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/android-arm64/libgoo-harfbuzz.so;$(GooNativeRuntimeRoot)/android-arm64/libgoo-harfbuzz-gpu.so;$(GooNativeRuntimeRoot)/android-arm64/text-native-build.json">
      <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
      <TargetFileName>%(Filename)%(Extension)</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/android-x64/libgoo-harfbuzz.so;$(GooNativeRuntimeRoot)/android-x64/libgoo-harfbuzz-gpu.so;$(GooNativeRuntimeRoot)/android-x64/text-native-build.json">
      <RuntimeIdentifier>android-x64</RuntimeIdentifier>
      <TargetFileName>%(Filename)%(Extension)</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/linux-x64/libgoo-harfbuzz.so">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <TargetFileName>libgoo-harfbuzz.so</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/linux-x64/libgoo-harfbuzz-gpu.so">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <TargetFileName>libgoo-harfbuzz-gpu.so</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/linux-x64/text-native-build.json">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <TargetFileName>text-native-build.json</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/win-x64/goo-harfbuzz.dll">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <TargetFileName>goo-harfbuzz.dll</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/win-x64/goo-harfbuzz-gpu.dll">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <TargetFileName>goo-harfbuzz-gpu.dll</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooNativeRuntimeRoot)/win-x64/text-native-build.json">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <TargetFileName>text-native-build.json</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooLinuxSdlPath)"
                      Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <TargetFileName>libSDL3.so</TargetFileName>
    </GooNativePayload>
    <GooNativePayload Include="$(GooWindowsSdlPath)"
                      Condition="'$(GooWindowsSdlPath)' != '' and Exists('$(GooWindowsSdlPath)')">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <TargetFileName>SDL3.dll</TargetFileName>
    </GooNativePayload>
    <GooNativePayload Include="$(GooMacOsArm64NativeRoot)/libSDL3.dylib"
                      Condition="'$(GooMacOsArm64NativeRoot)' != ''">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <TargetFileName>libSDL3.dylib</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooMacOsArm64NativeRoot)/libMoltenVK.dylib"
                      Condition="'$(GooMacOsArm64NativeRoot)' != ''">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <TargetFileName>libMoltenVK.dylib</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz.dylib"
                      Condition="'$(GooMacOsArm64NativeRoot)' != ''">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <TargetFileName>libgoo-harfbuzz.dylib</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz-gpu.dylib"
                      Condition="'$(GooMacOsArm64NativeRoot)' != ''">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <TargetFileName>libgoo-harfbuzz-gpu.dylib</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
    <GooNativePayload Include="$(GooMacOsArm64NativeRoot)/text-native-build.json"
                      Condition="'$(GooMacOsArm64NativeRoot)' != ''">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <TargetFileName>text-native-build.json</TargetFileName>
      <Required>true</Required>
    </GooNativePayload>
  </ItemGroup>
  <ItemGroup>
    <!--
      nuget.org strips the raw HTML (the centered banner and badge markup) that
      GitHub renders fine, so the packed NuGet README is a separate, plain
      Markdown file rather than the repository root README.md.
    -->
    <None Include="$(MSBuildProjectDirectory)/../docs/nuget-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildProjectDirectory)/../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildProjectDirectory)/../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildProjectDirectory)/../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildProjectDirectory)/Goo.targets"
          Pack="true" PackagePath="buildTransitive/Goo.targets" />
    <None Include="$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.dll"
          Pack="true" PackagePath="tools/net10.0/any/Goo.ShaderEffectTool.dll" />
    <None Include="$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.deps.json"
          Pack="true" PackagePath="tools/net10.0/any/Goo.ShaderEffectTool.deps.json" />
    <None Include="$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.runtimeconfig.json"
          Pack="true" PackagePath="tools/net10.0/any/Goo.ShaderEffectTool.runtimeconfig.json" />
    <None Remove="@(GooNativePayload)" />
    <None Include="@(GooNativePayload)"
          Pack="true"
          PackagePath="runtimes/%(RuntimeIdentifier)/native/%(TargetFileName)">
      <Link Condition="'%(RuntimeIdentifier)' == '$(GooEffectiveRuntimeIdentifier)'">%(TargetFileName)</Link>
      <CopyToOutputDirectory Condition="'%(RuntimeIdentifier)' == '$(GooEffectiveRuntimeIdentifier)'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'%(RuntimeIdentifier)' == '$(GooEffectiveRuntimeIdentifier)'">Always</CopyToPublishDirectory>
    </None>

    <None Update="$(GooVulkanShaderRoot)/*.spv"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Shaders/%(Filename)%(Extension)"
          PackageBuildAction="None"
          PackageCopyToOutput="true" />
    <None Update="$(GooVulkanShaderRoot)/shader-manifest.json"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Shaders/shader-manifest.json"
          PackageBuildAction="None"
          PackageCopyToOutput="true" />
    <None Update="$(GooVulkanShaderRoot)/harfbuzz-14.3.1.provenance.json"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Shaders/harfbuzz-14.3.1.provenance.json"
          PackageBuildAction="None"
          PackageCopyToOutput="true" />
    <None Update="$(MSBuildProjectDirectory)/Shaders/Authoring/goo_effect.glsl"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Shaders/Authoring/goo_effect.glsl"
          PackageBuildAction="None"
          PackageCopyToOutput="false" />
    <None Update="$(MSBuildProjectDirectory)/Shaders/Authoring/goo_effect.slang"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Shaders/Authoring/goo_effect.slang"
          PackageBuildAction="None"
          PackageCopyToOutput="false" />
    <None Update="$(GooNativeRuntimeRoot)/HarfBuzz-COPYING.txt"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Runtime/HarfBuzz-COPYING.txt"
          PackageBuildAction="None"
          PackageCopyToOutput="true" />
    <None Update="$(GooNativeRuntimeRoot)/MoltenVK-LICENSE.txt"
          Pack="true"
          PackagePath="contentFiles/any/any/Vulkan/Runtime/MoltenVK-LICENSE.txt"
          PackageBuildAction="None"
          PackageCopyToOutput="true" />

    <None Update="$(GooVulkanShaderRoot)/*.spv"
          Link="Vulkan/Shaders/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Update="$(GooVulkanShaderRoot)/shader-manifest.json"
          Link="Vulkan/Shaders/shader-manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Update="$(GooVulkanShaderRoot)/harfbuzz-14.3.1.provenance.json"
          Link="Vulkan/Shaders/harfbuzz-14.3.1.provenance.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Update="$(GooNativeRuntimeRoot)/HarfBuzz-COPYING.txt"
          Link="Vulkan/Runtime/HarfBuzz-COPYING.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Update="$(GooNativeRuntimeRoot)/MoltenVK-LICENSE.txt"
          Link="Vulkan/Runtime/MoltenVK-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="BuildGooShaderEffectToolForPackage">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/Goo.ShaderEffectTool.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);TreatWarningsAsErrors=true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.dll')"
           Text="Goo ShaderEffect build tool is missing." />
  </Target>

  <Target Name="ValidateGooVulkanPackageAssets" BeforeTargets="Build;Pack">
    <Error Condition="!Exists('$(GooVulkanShaderRoot)/solid_quad.vert.spv')"
           Text="Goo Vulkan asset is missing: $(GooVulkanShaderRoot)/solid_quad.vert.spv" />
    <Error Condition="!Exists('$(GooVulkanShaderRoot)/solid_quad.frag.spv')"
           Text="Goo Vulkan asset is missing: $(GooVulkanShaderRoot)/solid_quad.frag.spv" />
    <Error Condition="!Exists('$(GooVulkanShaderRoot)/path_band.vert.spv')"
           Text="Goo Vulkan path-band vertex shader is missing: $(GooVulkanShaderRoot)/path_band.vert.spv" />
    <Error Condition="!Exists('$(GooVulkanShaderRoot)/path_band.frag.spv')"
           Text="Goo Vulkan path-band fragment shader is missing: $(GooVulkanShaderRoot)/path_band.frag.spv" />
    <Error Condition="!Exists('$(GooVulkanShaderRoot)/shader-manifest.json')"
           Text="Goo Vulkan metadata is missing: $(GooVulkanShaderRoot)/shader-manifest.json" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Shaders/Authoring/goo_effect.glsl')"
           Text="Goo Vulkan shader-effect authoring include is missing." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Shaders/Authoring/goo_effect.slang')"
           Text="Goo Slang shader-effect authoring include is missing." />
    <Error Condition="!Exists('$(GooNativeRuntimeRoot)/HarfBuzz-COPYING.txt')"
           Text="Goo Vulkan HarfBuzz license is missing." />
    <Error Condition="!Exists('$(GooNativeRuntimeRoot)/MoltenVK-LICENSE.txt')"
           Text="Goo MoltenVK license is missing." />
  </Target>

  <Target Name="ValidateGooNativePayloads" BeforeTargets="Build;Pack">
    <Error Condition="'%(GooNativePayload.Required)' == 'true' and !Exists('%(GooNativePayload.FullPath)')"
           Text="Required Goo native payload is missing: %(GooNativePayload.FullPath)" />
  </Target>

  <Target Name="ValidateGooLinuxSdlPackageAsset" BeforeTargets="Pack">
    <Error Condition="'$(GooLinuxSdlPath)' == '' or !Exists('$(GooLinuxSdlPath)')"
           Text="Packing Goo requires -p:GooLinuxSdlPath=/absolute/path/to/a glibc-2.27-compatible libSDL3.so." />
  </Target>
  <Target Name="ValidateGooWindowsSdlPackageAsset" BeforeTargets="Pack">
    <Error Condition="'$(GooWindowsSdlPath)' == '' or !Exists('$(GooWindowsSdlPath)')"
           Text="Packing Goo requires -p:GooWindowsSdlPath=/absolute/path/to/SDL3.dll from the pinned SDL release." />
  </Target>
  <Target Name="ValidateGooMacOsArm64PackageAssets" BeforeTargets="Pack">
    <Error Condition="'$(GooMacOsArm64NativeRoot)' == ''"
           Text="Packing Goo requires -p:GooMacOsArm64NativeRoot=/absolute/path/to/the pinned osx-arm64 native payloads." />
    <Error Condition="'$(GooMacOsArm64NativeRoot)' != '' and !Exists('$(GooMacOsArm64NativeRoot)/libSDL3.dylib')"
           Text="The pinned osx-arm64 SDL payload is missing." />
    <Error Condition="'$(GooMacOsArm64NativeRoot)' != '' and !Exists('$(GooMacOsArm64NativeRoot)/libMoltenVK.dylib')"
           Text="The pinned osx-arm64 MoltenVK payload is missing." />
    <Error Condition="'$(GooMacOsArm64NativeRoot)' != '' and !Exists('$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz.dylib')"
           Text="The pinned osx-arm64 HarfBuzz payload is missing." />
    <Error Condition="'$(GooMacOsArm64NativeRoot)' != '' and !Exists('$(GooMacOsArm64NativeRoot)/libgoo-harfbuzz-gpu.dylib')"
           Text="The pinned osx-arm64 hb-gpu payload is missing." />
    <Error Condition="'$(GooMacOsArm64NativeRoot)' != '' and !Exists('$(GooMacOsArm64NativeRoot)/text-native-build.json')"
           Text="The pinned osx-arm64 text-native provenance is missing." />
  </Target>
  <Target Name="_PopulateGooDocFileItems"
          AfterTargets="CoreCompile"
          Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <GooXmlSupplement>$(MSBuildProjectDirectory)/../docs/api/Goo.xml.supplement.xml</GooXmlSupplement>
    <GooXmlDocsMergeProject>$(MSBuildProjectDirectory)/../tools/Goo.XmlDocsMerge/Goo.XmlDocsMerge.csproj</GooXmlDocsMergeProject>
    <GooXmlDocsMergePath>$(MSBuildProjectDirectory)/../tools/Goo.XmlDocsMerge/bin/$(Configuration)/net10.0/Goo.XmlDocsMerge.dll</GooXmlDocsMergePath>
    <GooXmlDocsDotNetHost Condition="'$(GooXmlDocsDotNetHost)' == '' and '$(DotNetHostPath)' != ''">$(DotNetHostPath)</GooXmlDocsDotNetHost>
    <GooXmlDocsDotNetHost Condition="'$(GooXmlDocsDotNetHost)' == ''">dotnet</GooXmlDocsDotNetHost>
  </PropertyGroup>
  <Target Name="BuildGooXmlDocsMerge"
          Condition="'$(DocumentationFile)' != ''">
    <MSBuild Projects="$(GooXmlDocsMergeProject)"
             Targets="Restore;Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot"
             Properties="Configuration=$(Configuration);TreatWarningsAsErrors=true" />
  </Target>
  <Target Name="MergeGooXmlSupplement"
          AfterTargets="CoreCompile"
          DependsOnTargets="BuildGooXmlDocsMerge"
          Condition="'$(DocumentationFile)' != ''">
    <Error Condition="!Exists('$(GooXmlSupplement)')"
           Text="Goo XML documentation supplement is missing: $(GooXmlSupplement)" />
    <Exec Command="&quot;$(GooXmlDocsDotNetHost)&quot; exec &quot;$(GooXmlDocsMergePath)&quot; --generated &quot;$(MSBuildProjectDirectory)/$([System.String]::Copy('$(DocumentationFile)').Replace('\', '/'))&quot; --supplement &quot;$(GooXmlSupplement)&quot;" />
  </Target>
  <Target Name="IncludeGooImplementationAssemblies"
          DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Yoga.Net'">
        <TargetPath>%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</TargetPath>
        <FinalOutputPath>%(ReferenceCopyLocalPaths.FullPath)</FinalOutputPath>
      </BuildOutputInPackage>
      <BuildOutputInPackage Include="$(TargetDir)Goo.xml" Condition="Exists('$(TargetDir)Goo.xml')">
        <TargetPath>Goo.xml</TargetPath>
        <FinalOutputPath>$(TargetDir)Goo.xml</FinalOutputPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
