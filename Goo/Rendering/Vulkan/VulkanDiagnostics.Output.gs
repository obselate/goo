  private func Hex(buffer [] ? uint8, offset int32, length uint32) string {
    let text = StringBuilder()
    if let bytes = buffer {
      var index uint32 = 0u
      while index < length {
        text.Append(bytes[offset + int32(index)].ToString("x2"))
        index++
      }
    }
    return text.ToString()
  }

