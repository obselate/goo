<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo</RootNamespace>
    <PackageId>Goo</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>A retained, declarative UI framework for G#.</Description>
    <PackageTags>gsharp;ui;gui;declarative;retained</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See the packaged CHANGELOG.md for the changes, supported surface, and limitations of this release.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/obselate/goo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders/Vulkan/*.spv;Shaders/Vulkan/shader-manifest.json"
                      LogicalName="Goo.Vulkan.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Shaders/Effects/*.goo-effect"
                      LogicalName="Goo.Effects.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(IntermediateOutputPath)filtered_backdrop.goo-effect"
                      LogicalName="Goo.Effects.filtered_backdrop.goo-effect" />
    <EmbeddedResource Include="Rendering/Text/Data/*.bin"
                      LogicalName="Goo.Text.Data.%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../vendor/Yoga.Net/src/Yoga.Net/Yoga.Net.csproj"
                      PrivateAssets="all" />
    <PackageReference Include="Hexa.NET.SDL3" ExcludeAssets="native" />
    <PackageReference Include="Unicode.Bidi" />
  </ItemGroup>
  <Import Project="$(GooTestFixturesProps)"
          Condition="'$(IncludeTestFixtures)' == 'true' and '$(GooTestFixturesProps)' != ''" />
  <Import Project="Goo.Packaging.targets" />
  <Target Name="CompileFilteredBackdrop" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildGooShaderEffectToolForPackage"
          Inputs="Shaders/Effects/filtered_backdrop.slang;Shaders/Authoring/goo_effect.slang;../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.dll"
          Outputs="$(IntermediateOutputPath)filtered_backdrop.goo-effect">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../tools/Goo.ShaderEffectTool/bin/$(Configuration)/net10.0/Goo.ShaderEffectTool.dll&quot; compile &quot;$(MSBuildProjectDirectory)/Shaders/Effects/filtered_backdrop.slang&quot; &quot;$(MSBuildProjectDirectory)/Shaders/Authoring&quot; &quot;$(IntermediateOutputPath)filtered_backdrop.goo-effect&quot; &quot;$(IntermediateOutputPath)filtered_backdrop.json&quot;" />
  </Target>
</Project>
