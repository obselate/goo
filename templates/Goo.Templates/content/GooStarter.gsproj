<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooStarter</RootNamespace>
    <AssemblyName>GooStarter</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="0.7.22" />
  </ItemGroup>
</Project>
