        },
        "delta_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta X"
        },
        "delta_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Y"
        },
        "button": {
          "default": "Primary",
          "title": "Button",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "alt": {
          "default": false,
          "title": "Alt",
          "type": "boolean"
        },
        "ctrl": {
          "default": false,
          "title": "Ctrl",
          "type": "boolean"
        },
        "shift": {
          "default": false,
          "title": "Shift",
          "type": "boolean"
        },
        "super": {
