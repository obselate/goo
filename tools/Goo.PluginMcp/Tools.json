          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "window": {
          "default": "",
          "title": "Window",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "node_id": {
