<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PackAsTool>true</PackAsTool>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ToolCommandName>goo</ToolCommandName>
    <PackageId>Goo.DevTools</PackageId>
    <Version>$(GooReleaseVersion)</Version>
    <Authors>Xaz</Authors>
    <Description>Local developer tooling for Goo applications.</Description>
    <PackageTags>goo;gsharp;devtools;hot-reload;inspector</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/obselate/goo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/obselate/goo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo.PluginMcp/Goo.PluginMcp.gsproj" />
    <Compile Include="../../Goo/Input/Key.gs" Link="Input/Key.gs" />
    <ProjectReference Include="../../apps/Goo.DevTools/Goo.DevTools.gsproj" ReferenceOutputAssembly="false" Private="false" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildProjectDirectory)/../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../.github/scripts/stage-linux-x64.sh" Link="Packaging/stage-linux-x64.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../.github/scripts/stage-macos-arm64.sh" Link="Packaging/stage-macos-arm64.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Packaging/*.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Packaging/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BundleInspector" AfterTargets="Build">
    <ItemGroup>
      <InspectorFiles Include="../../apps/Goo.DevTools/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(InspectorFiles)" DestinationFiles="@(InspectorFiles->'$(OutputPath)inspector/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PackInspector" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <InspectorPackageFile Include="$(OutputPath)inspector/**/*" />
      <None Include="@(InspectorPackageFile)" Pack="true" PackagePath="tools/$(TargetFramework)/any/inspector/%(InspectorPackageFile.RecursiveDir)%(InspectorPackageFile.Filename)%(InspectorPackageFile.Extension)" />
    </ItemGroup>
  </Target>
</Project>
