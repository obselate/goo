<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooConsumerPerformance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="$(GooReleaseVersion)" />
    <Content Include="Assets/VendSans-VariableFont_wght.ttf" Link="VendSans-VariableFont_wght.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets/VendSans-OFL.txt" Link="VendSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
