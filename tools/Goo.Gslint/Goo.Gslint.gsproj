<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Gslint</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GSharp.Core">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/GSharp.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GSharp.Formatting">
      <HintPath>../../artifacts/gsharp/formatter/GSharp.Formatting.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
