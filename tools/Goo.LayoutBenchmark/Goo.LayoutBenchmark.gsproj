<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Goo/Goo.gsproj" AdditionalProperties="IncludeLayoutBenchmark=true" />
    <None Include="../../tests/Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf"
          Link="VendSans-VariableFont_wght.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Import Project="../../Goo/Goo.targets" />
</Project>
