<Project>
  <ItemGroup>
    <Reference Include="GSharp.Core">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/GSharp.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GSharp.Formatting">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/../formatter/GSharp.Formatting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="$(MSBuildThisFileDirectory)SourceFormatting.gs" Link="SourceFormatting.gs" />
  </ItemGroup>
</Project>
