          "libm.so"
        ]
      },
      "requiredRpath": {
        "harfbuzz": [],
        "gpu": []
      },
      "requiredRunpath": {
        "harfbuzz": [],
        "gpu": [
          "$ORIGIN/"
        ]
      }
    }
