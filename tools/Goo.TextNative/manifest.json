        "CXXFLAGS": "-O3 -g0 -ffile-prefix-map=<temporary-source-root>=.",
        "LDFLAGS": "-Wl,--build-id=none -Wl,-z,max-page-size=16384"
      },
      "android-x64": {
        "SOURCE_DATE_EPOCH": "0",
        "CFLAGS": "-O3 -g0 -ffile-prefix-map=<temporary-source-root>=.",
        "CXXFLAGS": "-O3 -g0 -ffile-prefix-map=<temporary-source-root>=.",
        "LDFLAGS": "-Wl,--build-id=none -Wl,-z,max-page-size=16384"
      }
    },
    "sourcePatch": "Set the core and GPU shared-library identities to Goo-owned private names before the pinned Meson build; Linux keeps private SONAMEs, macOS keeps private @rpath install names, and Windows uses unversioned DLL names.",
    "sourcePatches": [
      {
        "name": "cpal-linear-light",
        "path": "tools/Goo.TextNative/patches/harfbuzz-15.0.0-cpal-linear-light.patch",
        "sha256": "db74dc354fdcb7bc3ae8b9f7e02dcda1e662d8ff9b4737726a9569caced3072d",
        "upstreamPath": "src/hb-gpu-paint.cc",
        "upstreamSha256": "db822c4f947c787e583bb80d28143e7e9094728822fc81bcea9e901ca353c948",
        "patchedSha256": "44c68d7ceab1be78b6704e4c84b2793ebe6f5f4f1c713b01a04fbe7dc2f71a74",
        "description": "Convert explicit CPAL RGB bytes to linear-light Q15 with a fixed 256-entry lookup. Preserve alpha and foreground encoding."
      },
      {
        "name": "stb-gif-two-back",
        "path": "tools/Goo.TextNative/patches/stb-image-2.30-gif-two-back.patch",
        "sha256": "0b4b4a10c7e2e2c2601a661af02456d5bf68f750b3cb9a93d435da6590795135",
        "upstreamPath": "src/stb_image.h",
        "upstreamSha256": "594c2fe35d49488b4382dbfaec8f98366defca819d916ac95becf3e75f4200b3",
        "patchedSha256": "48b9cabe23f0a6b07654f2b7787535165695bd8bf563449088f0ab8ad7d842b2",
        "description": "Keep the GIF disposal history pointer inside the allocated frame buffer."
      }
    ],
    "soname": {
      "harfbuzz": "libgoo-harfbuzz.so",
      "gpu": "libgoo-harfbuzz-gpu.so"
    },
    "linux": {
      "requiredFormat": "ELF 64-bit LSB shared object, x86-64",
      "maxGlibc": "2.27",
      "requiredRpath": {
        "harfbuzz": [],
        "gpu": []
      },
      "requiredRunpath": {
        "harfbuzz": [],
        "gpu": [
          "$ORIGIN/"
        ]
      },
      "requiredNeeded": {
        "harfbuzz": [
          "libc.so.6",
          "libm.so.6",
          "libpthread.so.0"
        ],
        "gpu": [
          "libc.so.6",
          "libgoo-harfbuzz.so",
          "libm.so.6",
          "libpthread.so.0"
        ]
      }
    },
    "macos": {
      "requiredFormat": "Mach-O 64-bit dynamically linked shared library arm64",
      "requiredArchitectures": [
        "arm64"
      ],
      "requiredInstallName": {
        "harfbuzz": "@rpath/libgoo-harfbuzz.dylib",
        "gpu": "@rpath/libgoo-harfbuzz-gpu.dylib"
      },
      "requiredNeeded": {
        "harfbuzz": [
          "/usr/lib/libSystem.B.dylib"
        ],
        "gpu": [
          "/usr/lib/libSystem.B.dylib",
          "@rpath/libgoo-harfbuzz.dylib"
        ]
      },
      "forbiddenDependencyPrefixes": [
        "/opt/homebrew/",
        "/usr/local/"
      ]
    },
    "windows": {
      "target": "x86_64-w64-mingw32",
      "requiredFormat": "PE32+ x86-64",
      "linkerFlags": [
        "-static-libgcc",
        "-static-libstdc++",
        "-Wl,--no-insert-timestamp"
      ],
      "sourcePatch": "Rename the core and GPU targets to goo-harfbuzz.dll and goo-harfbuzz-gpu.dll, remove Meson version suffixes, and keep hb-gpu's core import as goo-harfbuzz.dll.",
      "gpuImport": "goo-harfbuzz.dll",
      "requiredNeeded": {
        "harfbuzz": [
          "KERNEL32.dll",
          "msvcrt.dll"
        ],
        "gpu": [
          "KERNEL32.dll",
          "goo-harfbuzz.dll",
          "msvcrt.dll"
        ]
      },
      "forbiddenImports": [
        "libstdc++",
        "libgcc",
        "winpthread",
        "libstdc++-6.dll",
        "libgcc_s_seh-1.dll",
        "libwinpthread-1.dll",
        "winpthread-1.dll",
        "freetype",
        "glib",
        "icu",
        "graphite",
        "zlib",
        "png"
      ]
    },
    "harfbuzzOptions": [
